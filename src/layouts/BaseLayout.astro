---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PrivacyConsent from "../components/ui/PrivacyConsent.astro";
import ImageLightbox from "../components/ui/ImageLightbox.astro";
import { imageAssets } from "../data/imageAssets";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const heroImage = imageAssets["/assets/hero.jpg"];
const logoImage = imageAssets["/assets/logo.png"];
---

<!doctype html>
<html lang="pl">
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#222222" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Pasieka 100% Natury" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
        <meta
          property="og:image"
          content={new URL(heroImage.src, Astro.site)}
        />
        <meta
          property="og:image:alt"
          content="Pszczoła wśród kwiatów — Pasieka 100% Natury"
        />
      </>
    )}
    <link rel="icon" type="image/png" href={logoImage.src} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Przejdź do treści
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PrivacyConsent />
    <ImageLightbox />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
