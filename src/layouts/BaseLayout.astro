---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PrivacyConsent from "../components/ui/PrivacyConsent.astro";
import ImageLightbox from "../components/ui/ImageLightbox.astro";
import SeoHead, { type BreadcrumbItem } from "../components/ui/SeoHead.astro";
import type { ImageAssetPath } from "../data/imageAssets";
import { site } from "../data/site";
interface Props {
  title: string;
  description: string;
  image?: ImageAssetPath;
  imageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
}
const { title, description, image, imageAlt, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <style is:inline>
      body {
        margin: 0;
      }
      .skip-link {
        position: fixed;
      }
      .header {
        height: 110px;
      }
      @media (max-width: 639px) {
        .header {
          height: 82px;
        }
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      breadcrumbs={breadcrumbs}
    />
    <meta name="theme-color" content="#222222" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Przejdź do treści
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PrivacyConsent />
    <ImageLightbox />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
