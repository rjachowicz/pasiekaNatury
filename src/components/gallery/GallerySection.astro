---
import AssetImage from "../ui/AssetImage.astro";
import { imageAssets, type ImageAssetPath } from "../../data/imageAssets";

const gallery: { src: ImageAssetPath; alt: string }[] = [
  { src: "/assets/hero.jpg", alt: "Pszczoła wśród białych kwiatów" },
  { src: "/assets/apiary.jpg", alt: "Ule na kwitnącej łące" },
  { src: "/assets/beekeeper.jpg", alt: "Pszczelarz przy ramce z pszczołami" },
  {
    src: "/assets/gallery-bee.jpg",
    alt: "Pszczoła zbierająca nektar z kwiatu",
  },
  {
    src: "/assets/gallery-honey.jpg",
    alt: "Złocisty miód spływający do słoika",
  },
  {
    src: "/assets/gallery-comb.jpg",
    alt: "Pszczoły pracujące na plastrze miodu",
  },
];
---

<section
  class="gallery section--sm"
  aria-labelledby="gallery-title"
  data-gallery
>
  <div class="container gallery__head" data-reveal>
    <p class="eyebrow eyebrow--line">Z bliska</p>
    <h2 id="gallery-title">Życie naszej pasieki</h2>
  </div>
  <div class="container">
    <div class="gallery__mosaic">
      {gallery.map(({ src, alt }) => (
        <button
          class="gallery__tile"
          type="button"
          data-lightbox-src={imageAssets[src].src}
          data-lightbox-alt={alt}
          data-lightbox-group="homepage-gallery"
          aria-haspopup="dialog"
          aria-label={`Powiększ zdjęcie: ${alt}`}
        >
          <AssetImage
            src={src}
            sizes="(max-width: 639px) 100vw, 50vw"
            widths={[320, 640, 960]}
            loading="lazy"
            alt={alt}
          />
          <span class="gallery__overlay" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="5.5" />
              <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5" />
            </svg>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>
<style>
  .gallery {
    padding-bottom: 0;
  }

  .gallery__head {
    margin-bottom: var(--space-4);
  }

  .gallery__head .eyebrow {
    margin-bottom: var(--space-2);
  }

  .gallery__mosaic {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr 1fr 1fr;
    grid-template-rows: repeat(2, 230px);
    gap: var(--space-2);
  }

  .gallery__tile {
    position: relative;
    display: block;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-dark);
    color: var(--color-white);
    cursor: zoom-in;
  }

  .gallery__tile:nth-child(1) {
    grid-row: span 2;
  }

  .gallery__tile:nth-child(5) {
    grid-column: span 2;
  }

  .gallery__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-dark-22);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .gallery__overlay svg {
    width: 38px;
    height: 38px;
  }

  .gallery__tile:hover .gallery__overlay,
  .gallery__tile:focus-visible .gallery__overlay {
    opacity: 1;
  }

  .gallery__tile:hover {
    box-shadow: var(--shadow-subtle);
  }

  @media (max-width: 639px) {
    .gallery__mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, 180px);
      gap: var(--space-1);
    }

    .gallery__tile:nth-child(1) {
      grid-row: span 2;
    }

    .gallery__tile:nth-child(5) {
      grid-column: auto;
    }
  }
</style>
