---
import AssetImage from "../ui/AssetImage.astro";
import { gallery } from "../../data/gallery";
---

<section class="gallery" aria-label="Z bliska — życie naszej pasieki">
  {gallery.map(({ file, alt }) => (
    <AssetImage
      src={`/assets/${file}`}
      sizes="(max-width: 639px) 100vw, 33vw"
      loading="lazy"
      alt={alt}
    />
  ))}
</section>
<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding-top: 8px;
  }

  .gallery img {
    width: 100%;
    height: 320px;
    object-fit: cover;
  }

  @media (max-width: 639px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      padding-top: 6px;
    }

    .gallery img:first-child {
      grid-column: 1 / -1;
      height: 280px;
      object-position: center 58%;
    }
  }

  @media (min-width: 640px) and (max-width: 899px) {
    .gallery img {
      height: 230px;
    }
  }
</style>
