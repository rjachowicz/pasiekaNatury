---
import AssetImage from "../ui/AssetImage.astro";
import Button from "../ui/Button.astro";
import NatureBadge from "../ui/NatureBadge.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow eyebrow--line">Naturalne miody</p>
    <h1 id="hero-title">
      Pasieka <span>100% Natury</span>
    </h1>
    <span class="accent-line" aria-hidden="true"></span>
    <p class="hero__text">
      Prawdziwe miody z czystych terenów, prosto z natury. Z szacunkiem do
      pszczół, tradycji i otaczającego nas środowiska.
    </p>
    <div class="hero__actions">
      <Button href="/o-pasiece">Nasza pasieka</Button>
      <AssetImage
        class="hero__bee"
        src="/assets/bee-flight.png"
        widths={[160, 320]}
        sizes="160px"
        alt=""
        aria-hidden="true"
      />
    </div>
  </div>
  <div class="hero__visual">
    <AssetImage
      class="hero__photo"
      sizes="(max-width: 899px) 100vw, 58vw"
      src="/assets/hero.jpg"
      widths={[640, 960, 1440]}
      alt="Pszczoły na plastrze miodu"
      loading="eager"
      fetchpriority="high"
    />
    <NatureBadge />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    min-height: var(--hero-desktop-height);
    background: var(--color-soft);
  }

  .hero__copy {
    display: flex;
    min-height: var(--hero-desktop-height);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--hero-copy-padding-block) var(--space-grid)
      var(--hero-copy-padding-block) var(--page-inset);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  h1 span {
    display: block;
  }

  .hero__text {
    max-width: 33ch;
    margin-bottom: var(--space-4);
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hero__bee {
    width: 138px;
    opacity: 0.58;
    pointer-events: none;
  }

  .hero__visual {
    position: relative;
    min-width: 0;
    min-height: var(--hero-desktop-height);
    overflow: hidden;
    background: var(--color-soft);
  }

  .hero__photo {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 47% center;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.42) 9%,
      rgba(0, 0, 0, 0.82) 21%,
      #000 34%,
      #000 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.42) 9%,
      rgba(0, 0, 0, 0.82) 21%,
      #000 34%,
      #000 100%
    );
  }

  .hero__visual :global(.nature-badge) {
    position: absolute;
    z-index: 1;
    right: min(var(--page-inset), var(--space-4));
    bottom: var(--space-4);
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      min-height: 0;
      padding: var(--hero-copy-padding-block) var(--page-inset);
    }

    .hero__visual {
      min-height: 0;
    }

    .hero__text {
      max-width: 48ch;
    }

    .hero__photo {
      object-position: 50% 46%;
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.22) 8%,
        rgba(0, 0, 0, 0.72) 20%,
        #000 33%,
        #000 100%
      );
      mask-image: linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.22) 8%,
        rgba(0, 0, 0, 0.72) 20%,
        #000 33%,
        #000 100%
      );
    }
  }

  @media (max-width: 639px) {
    .hero__copy {
      padding-block: var(--hero-copy-padding-block);
    }

    .hero__bee {
      width: 102px;
      opacity: 0.52;
    }

    .hero__visual {
      height: var(--hero-mobile-visual-height);
    }
  }

  @media (min-width: 640px) and (max-width: 899px) {
    .hero__visual {
      height: var(--hero-tablet-visual-height);
    }
  }
</style>
