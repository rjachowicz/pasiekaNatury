---
import Button from '../Button.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <div class="hero__intro">
      <p class="eyebrow">Naturalne miody</p>
      <img class="hero__bee" src="/assets/bee-flight.png" width="2048" height="682" alt="" aria-hidden="true" />
    </div>
    <h1 id="hero-title">Pasieka <span>100% Natury</span></h1>
    <span class="accent-line" aria-hidden="true"></span>
    <p class="hero__text">Prawdziwe miody z czystych terenów, prosto z natury. Z szacunkiem do pszczół, tradycji i otaczającego nas środowiska.</p>
    <div><Button href="/o-pasiece">Poznaj naszą pasiekę</Button></div>
  </div>
  <div class="hero__visual">
    <img class="hero__photo" src="/assets/hero.jpg" width="1672" height="941" alt="Pszczoła wśród białych kwiatów w ciepłym świetle słońca" fetchpriority="high" />
    <div class="hero__badge">
      <img src="/assets/icon-leaf.png" width="1536" height="1024" alt="" aria-hidden="true" />
      <strong>Czysta natura</strong><span>Prawdziwy miód</span>
    </div>
  </div>
</section>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 42fr) minmax(0, 58fr); min-height: clamp(620px, 45vw, 840px); }
  .hero__copy { display: flex; flex-direction: column; justify-content: center; padding: 112px clamp(24px, 3vw, 56px) 80px var(--page-inset); }
  .hero__intro { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .hero__intro .eyebrow { max-width: 15ch; }
  .hero__bee { width: clamp(100px, 11vw, 190px); min-width: 0; }
  h1 { font-size: clamp(3rem, 4.7vw, 5.65rem); text-transform: uppercase; letter-spacing: -.045em; line-height: .98; }
  h1 span { display: block; }
  .hero__text { max-width: 38ch; margin-bottom: 32px; font-size: .9rem; line-height: 1.8; }
  .hero__visual { position: relative; min-width: 0; }
  .hero__photo { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: 52% center; }
  .hero__badge { position: absolute; right: clamp(24px, 4vw, 72px); bottom: 36px; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 132px; aspect-ratio: 1; padding: 20px; color: var(--color-white); background: var(--color-dark); clip-path: var(--hexagon); text-align: center; line-height: 1.4; }
  .hero__badge img { width: 30px; height: 24px; object-fit: contain; margin-bottom: 5px; }
  .hero__badge strong { font-family: var(--font-serif); font-size: 1.2rem; }
  .hero__badge span { margin-top: 4px; font-size: .6rem; }
  @media (min-width: 2000px) { .hero__copy { padding-left: max(64px, calc((100vw - 1600px) / 2)); } }
  @media (min-width: 768px) and (max-width: 1100px) {
    .hero__copy { padding-left: 32px; padding-right: 24px; }
    h1 { font-size: clamp(2.5rem, 4.7vw, 3.3rem); }
    .hero__intro { flex-wrap: wrap; }
    .hero__intro .eyebrow { max-width: none; }
  }
  @media (max-width: 767px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero__copy { padding: 80px var(--gutter) 56px; }
    .hero__intro { max-width: 450px; }
    .hero__intro .eyebrow { max-width: none; }
    .hero__bee { width: 120px; }
    h1 { font-size: clamp(3rem, 10vw, 4.75rem); }
    .hero__visual { aspect-ratio: 4 / 3; }
    .hero__badge { width: 112px; bottom: 24px; }
  }
</style>
