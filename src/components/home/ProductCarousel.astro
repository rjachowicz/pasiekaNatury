---
import { isProductLogo, products } from "../../data/products";
import AssetImage from "../ui/AssetImage.astro";

const honeyProducts = products.filter(
  (product) => product.category === "honey",
);
---

{honeyProducts.length > 0 && (
  <div class="product-carousel" data-product-carousel>
    <div
      class="product-carousel__controls"
      aria-label="Sterowanie karuzelą produktów"
    >
      <button
        class="product-carousel__button"
        type="button"
        data-carousel-previous
        aria-label="Poprzedni produkt"
      >
        <span aria-hidden="true">←</span>
      </button>
      <button
        class="product-carousel__button"
        type="button"
        data-carousel-next
        aria-label="Następny produkt"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <div
      class="product-carousel__viewport"
      data-carousel-viewport
      aria-label="Produkty z naszej pasieki"
      role="region"
      tabindex="0"
    >
      <div class="product-carousel__track" data-carousel-track>
        {honeyProducts.map((product, productIndex) => (
          <article class="product-carousel__card" data-carousel-card>
            <a
              href={`/produkty/${product.id}`}
              aria-label={`Poznaj ${product.name.toLocaleLowerCase("pl")}`}
            >
              <div
                class:list={[
                  "product-carousel__image-wrap",
                  {
                    "product-carousel__image-wrap--photo":
                      !isProductLogo(product),
                  },
                ]}
                style={`--product-image-position: ${product.imagePosition ?? "center"}`}
              >
                <AssetImage
                  src={product.image}
                  sizes="(max-width: 639px) min(276px, calc(100vw - 40px)), 360px"
                  widths={[320, 480, 640, 768]}
                  loading="lazy"
                  fetchpriority="low"
                  alt={product.imageAlt}
                />
              </div>
              <div class="product-carousel__body">
                <span class="product-carousel__number" aria-hidden="true">
                  {String(productIndex + 1).padStart(2, "0")}
                </span>
                <h3>{product.name}</h3>
                <p>{product.shortDescription}</p>
                <span class="product-carousel__arrow" aria-hidden="true">
                  →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  import "../../scripts/productCarousel";
</script>

<style>
  .product-carousel {
    padding-top: var(--space-4);
  }
  .product-carousel__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: var(--space-2);
  }
  .product-carousel__button {
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-dark);
    cursor: pointer;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .product-carousel__button:hover,
  .product-carousel__button:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow: var(--shadow-subtle);
  }
  .product-carousel__viewport {
    overflow: hidden;
    touch-action: pan-y;
  }
  .product-carousel__track {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    will-change: transform;
  }
  .product-carousel__card {
    display: flex;
    flex: 0 0 min(360px, calc(100vw - var(--gutter) * 2));
    min-width: 0;
    min-height: 530px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .product-carousel__card > a {
    display: flex;
    width: 100%;
    flex: 1;
    flex-direction: column;
  }
  .product-carousel__image-wrap {
    display: grid;
    flex: 0 0 clamp(220px, 58vw, 280px);
    height: clamp(220px, 58vw, 280px);
    min-height: clamp(220px, 58vw, 280px);
    padding: var(--space-2);
    place-items: center;
    border-bottom: var(--border);
    background: var(--color-soft);
    overflow: hidden;
  }
  .product-carousel__image-wrap--photo {
    position: relative;
    display: block;
    padding: 0;
  }
  .product-carousel__image-wrap--photo :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--product-image-position);
  }
  .product-carousel__image-wrap:not(.product-carousel__image-wrap--photo)
    :global(img) {
    display: block;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    max-width: min(100%, 255px);
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .product-carousel__body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: var(--space-3) var(--space-3) var(--space-4);
  }
  .product-carousel__number {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .product-carousel h3 {
    max-width: 12ch;
    font-size: var(--text-card-title);
  }
  .product-carousel p {
    max-width: 30ch;
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .product-carousel__arrow {
    display: inline-flex;
    align-self: flex-end;
    margin-top: auto;
    color: var(--color-muted);
    transition:
      transform var(--transition),
      color var(--transition);
  }
  .product-carousel__card > a:hover .product-carousel__arrow,
  .product-carousel__card > a:focus-visible .product-carousel__arrow {
    color: var(--color-dark);
    transform: translateX(4px);
  }
  @media (max-width: 639px) {
    .product-carousel__card {
      flex-basis: min(276px, calc(100vw - var(--gutter) * 2));
      min-height: 0;
    }
  }
</style>
