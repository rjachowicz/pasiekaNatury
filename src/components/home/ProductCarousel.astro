---
import { products } from "../../data/products";
import AssetImage from "../ui/AssetImage.astro";

const featuredProducts = products.filter((product) => product.featured);
---

{featuredProducts.length > 0 && (
  <div class="product-carousel" data-product-carousel>
    <div
      class="product-carousel__controls"
      aria-label="Sterowanie karuzelą produktów"
    >
      <button
        class="product-carousel__button"
        type="button"
        data-carousel-previous
        aria-label="Poprzedni produkt"
      >
        <span aria-hidden="true">←</span>
      </button>
      <button
        class="product-carousel__button"
        type="button"
        data-carousel-next
        aria-label="Następny produkt"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <div
      class="product-carousel__viewport"
      data-carousel-viewport
      aria-label="Produkty z naszej pasieki"
      role="region"
      tabindex="0"
    >
      <div class="product-carousel__track" data-carousel-track>
        {featuredProducts.map((product, productIndex) => (
          <article
            class="product-carousel__card"
            data-carousel-card
            data-product-index={productIndex}
          >
            <a
              href={`/produkty/${product.id}`}
              aria-label={`Poznaj ${product.name.toLocaleLowerCase("pl")}`}
            >
              <div class="product-carousel__image-wrap">
                <AssetImage
                  src={product.image}
                  sizes="255px"
                  widths={[320, 640]}
                  loading="lazy"
                  alt={`Produkt: ${product.name.toLocaleLowerCase("pl")}`}
                />
              </div>
              <div class="product-carousel__body">
                <span class="product-carousel__number" aria-hidden="true">
                  {String(productIndex + 1).padStart(2, "0")}
                </span>
                <h3>{product.name}</h3>
                <p>{product.shortDescription}</p>
                <span class="product-carousel__arrow" aria-hidden="true">
                  →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  document
    .querySelectorAll<HTMLElement>("[data-product-carousel]")
    .forEach((carousel) => {
      const viewport = carousel.querySelector<HTMLElement>(
        "[data-carousel-viewport]",
      );
      const track = carousel.querySelector<HTMLElement>(
        "[data-carousel-track]",
      );
      const previous = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-previous]",
      );
      const next = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );
      if (!viewport || !track || !previous || !next) return;

      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      let step = 0;
      let moving = false;
      let queuedDirection: -1 | 1 | null = null;
      let direction: -1 | 1 = 1;
      let startX = 0;
      const cards = () => [
        ...track.querySelectorAll<HTMLElement>("[data-carousel-card]"),
      ];
      const measure = () => {
        const first = cards()[0];
        if (!first) return;
        step =
          first.getBoundingClientRect().width +
          Number.parseFloat(getComputedStyle(track).gap || "0");
        track.style.transform = "translateX(0)";
      };
      const finish = () => {
        if (!moving) return;
        track.style.transition = "none";
        if (direction === 1) track.append(cards()[0]);
        else track.prepend(cards().at(-1)!);
        track.style.transform = "translateX(0)";
        track.getBoundingClientRect();
        moving = false;
        if (queuedDirection !== null) {
          const nextDirection = queuedDirection;
          queuedDirection = null;
          move(nextDirection);
        }
      };
      const move = (nextDirection: -1 | 1) => {
        if (cards().length < 2 || step === 0) return;
        if (moving) {
          queuedDirection = nextDirection;
          return;
        }
        direction = nextDirection;
        if (direction === -1) {
          track.style.transition = "none";
          track.prepend(cards().at(-1)!);
          track.style.transform = `translateX(${-step}px)`;
          track.getBoundingClientRect();
        }
        moving = true;
        if (motion.matches) {
          track.style.transition = "none";
          track.style.transform = `translateX(${direction === 1 ? -step : 0}px)`;
          finish();
          return;
        }
        track.style.transition = "transform 360ms ease";
        track.style.transform = `translateX(${direction === 1 ? -step : 0}px)`;
      };
      track.addEventListener("transitionend", (event) => {
        if (event.target === track && event.propertyName === "transform")
          finish();
      });
      previous.addEventListener("click", () => move(-1));
      next.addEventListener("click", () => move(1));
      viewport.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          move(event.key === "ArrowLeft" ? -1 : 1);
        }
      });
      viewport.addEventListener("pointerdown", (event) => {
        if (event.pointerType !== "mouse") startX = event.clientX;
      });
      viewport.addEventListener("pointerup", (event) => {
        if (!startX || event.pointerType === "mouse") return;
        const distance = event.clientX - startX;
        startX = 0;
        if (Math.abs(distance) >= 36) move(distance < 0 ? 1 : -1);
      });
      viewport.addEventListener("pointercancel", () => (startX = 0));
      new ResizeObserver(measure).observe(viewport);
      measure();
    });
</script>

<style>
  .product-carousel {
    padding-top: var(--space-4);
  }
  .product-carousel__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: var(--space-2);
  }
  .product-carousel__button {
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-dark);
    cursor: pointer;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .product-carousel__button:hover,
  .product-carousel__button:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow: var(--shadow-subtle);
  }
  .product-carousel__viewport {
    overflow: hidden;
    touch-action: pan-y;
  }
  .product-carousel__track {
    display: flex;
    gap: var(--space-3);
    will-change: transform;
  }
  .product-carousel__card {
    flex: 0 0 min(360px, calc(100vw - var(--gutter) * 2));
    min-width: 0;
    height: 530px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .product-carousel__card > a {
    display: grid;
    height: 100%;
    grid-template-rows: 58% 42%;
  }
  .product-carousel__image-wrap {
    display: grid;
    aspect-ratio: 1.15 / 1;
    padding: var(--space-2);
    place-items: center;
    border-bottom: var(--border);
    background: var(--color-soft);
  }
  .product-carousel__image-wrap :global(img) {
    width: min(100%, 255px);
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .product-carousel__body {
    position: relative;
    min-height: 0;
    padding: var(--space-3) var(--space-3) var(--space-4);
  }
  .product-carousel__number {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .product-carousel h3 {
    max-width: 12ch;
    font-size: var(--text-card-title);
  }
  .product-carousel p {
    max-width: 30ch;
    margin-top: var(--space-2);
    padding-right: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .product-carousel__arrow {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    color: var(--color-muted);
    transition:
      transform var(--transition),
      color var(--transition);
  }
  .product-carousel__card > a:hover .product-carousel__arrow,
  .product-carousel__card > a:focus-visible .product-carousel__arrow {
    color: var(--color-dark);
    transform: translateX(4px);
  }
  @media (max-width: 639px) {
    .product-carousel__card {
      flex-basis: min(276px, calc(100vw - var(--gutter) * 2));
      height: 490px;
    }
  }
</style>
