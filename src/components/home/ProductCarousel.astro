---
import { products } from "../../data/products";
import AssetImage from "../ui/AssetImage.astro";

const items = [
  ...products.map((product) => ({ product, clone: true })),
  ...products.map((product) => ({ product, clone: false })),
  ...products.map((product) => ({ product, clone: true })),
];
---

<div class="product-carousel" data-product-carousel>
  <div
    class="product-carousel__controls"
    aria-label="Sterowanie karuzelą produktów"
  >
    <button
      class="product-carousel__button"
      type="button"
      data-carousel-previous
      aria-label="Poprzedni produkt"
    >
      <span aria-hidden="true">←</span>
    </button>
    <button
      class="product-carousel__button"
      type="button"
      data-carousel-next
      aria-label="Następny produkt"
    >
      <span aria-hidden="true">→</span>
    </button>
  </div>
  <div
    class="product-carousel__viewport"
    data-carousel-viewport
    aria-label="Produkty z naszej pasieki"
    role="region"
    tabindex="0"
  >
    {items.map(({ product, clone }) => (
      <article
        class="product-carousel__card"
        data-carousel-card
        data-original={clone ? undefined : "true"}
        aria-hidden={clone ? "true" : undefined}
        inert={clone || undefined}
        data-reveal={clone ? undefined : true}
      >
        <a
          href={`/produkty/${product.id}`}
          tabindex={clone ? "-1" : undefined}
          aria-label={
            clone ? undefined : `Poznaj ${product.name.toLocaleLowerCase("pl")}`
          }
        >
          <div class="product-carousel__image-wrap">
            <AssetImage
              src={product.image}
              sizes="255px"
              loading="lazy"
              alt={
                clone ? "" : `Słoik: ${product.name.toLocaleLowerCase("pl")}`
              }
            />
          </div>
          <div class="product-carousel__body">
            <span class="product-carousel__number" aria-hidden="true">
              {String(
                products.findIndex(({ id }) => id === product.id) + 1,
              ).padStart(2, "0")}
            </span>
            <h3>{product.name}</h3>
            <p>{product.shortDescription}</p>
            <span class="product-carousel__arrow" aria-hidden="true">
              →
            </span>
          </div>
        </a>
      </article>
    ))}
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-product-carousel]")
    .forEach((carousel) => {
      const viewport = carousel.querySelector<HTMLElement>(
        "[data-carousel-viewport]",
      );
      const previous = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-previous]",
      );
      const next = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );
      const originals = [
        ...carousel.querySelectorAll<HTMLElement>('[data-original="true"]'),
      ];

      if (!viewport || !previous || !next || originals.length === 0) return;

      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const first = originals[0];
      const last = originals[originals.length - 1];
      let cycleStart = 0;
      let cycleEnd = 0;
      let cycleWidth = 0;
      let scrollTimer = 0;
      let isAdjusting = false;

      const measure = () => {
        const gap = Number.parseFloat(
          getComputedStyle(viewport).columnGap || "0",
        );
        cycleStart = first.offsetLeft;
        cycleEnd = last.offsetLeft + last.offsetWidth + gap;
        cycleWidth = cycleEnd - cycleStart;
      };

      const normalizePosition = () => {
        if (isAdjusting || cycleWidth === 0) return;

        const position = viewport.scrollLeft;
        if (position < cycleStart - 1) {
          isAdjusting = true;
          viewport.scrollTo({ left: position + cycleWidth, behavior: "auto" });
        } else if (position >= cycleEnd - 1) {
          isAdjusting = true;
          viewport.scrollTo({ left: position - cycleWidth, behavior: "auto" });
        } else {
          return;
        }

        requestAnimationFrame(() => {
          isAdjusting = false;
        });
      };

      const finishScrolling = () => {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(normalizePosition, 90);
      };

      const scrollToAdjacentCard = (direction: number) => {
        const cards = [
          ...viewport.querySelectorAll<HTMLElement>("[data-carousel-card]"),
        ];
        const currentIndex = cards.reduce((closestIndex, card, index) => {
          const closest = cards[closestIndex];
          return Math.abs(card.offsetLeft - viewport.scrollLeft) <
            Math.abs(closest.offsetLeft - viewport.scrollLeft)
            ? index
            : closestIndex;
        }, 0);
        const target = cards[currentIndex + direction];

        if (!target) return;
        viewport.scrollTo({
          left: target.offsetLeft,
          behavior: reduceMotion.matches ? "auto" : "smooth",
        });
      };

      requestAnimationFrame(() => {
        measure();
        viewport.scrollLeft = cycleStart;
      });

      previous.addEventListener("click", () => scrollToAdjacentCard(-1));
      next.addEventListener("click", () => scrollToAdjacentCard(1));
      viewport.addEventListener("scroll", finishScrolling, { passive: true });
      viewport.addEventListener("scrollend", normalizePosition);
      new ResizeObserver(() => {
        measure();
        normalizePosition();
      }).observe(viewport);
    });
</script>

<style>
  .product-carousel {
    position: relative;
    padding-top: var(--space-4);
  }
  .product-carousel__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: var(--space-2);
  }
  .product-carousel__button {
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-dark);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition);
  }
  .product-carousel__button:hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }
  .product-carousel__viewport {
    display: grid;
    grid-auto-columns: minmax(300px, 360px);
    grid-auto-flow: column;
    gap: var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .product-carousel__viewport::-webkit-scrollbar {
    display: none;
  }
  .product-carousel__card {
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .product-carousel__card > a {
    display: grid;
    height: 100%;
  }
  .product-carousel__image-wrap {
    display: grid;
    height: 310px;
    padding: var(--space-2);
    place-items: center;
    border-bottom: var(--border);
    background: var(--color-soft);
  }
  .product-carousel__image-wrap :global(img) {
    width: min(100%, 255px);
    height: 100%;
    object-fit: contain;
  }
  .product-carousel__body {
    position: relative;
    min-height: 220px;
    padding: var(--space-3) var(--space-3) var(--space-4);
  }
  .product-carousel__number {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .product-carousel h3 {
    max-width: 12ch;
    font-size: var(--text-card-title);
  }
  .product-carousel p {
    max-width: 30ch;
    margin-top: var(--space-2);
    padding-right: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .product-carousel__arrow {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    color: var(--color-muted);
    transition:
      transform var(--transition),
      color var(--transition);
  }
  .product-carousel__card > a:hover .product-carousel__arrow,
  .product-carousel__card > a:focus-visible .product-carousel__arrow {
    color: var(--color-dark);
    transform: translateX(4px);
  }
  @media (max-width: 899px) {
    .product-carousel__viewport {
      grid-auto-columns: 320px;
    }
  }
  @media (max-width: 639px) {
    .product-carousel {
      margin-right: calc(var(--gutter) * -1);
    }
    .product-carousel__controls {
      padding-right: var(--gutter);
    }
    .product-carousel__viewport {
      grid-auto-columns: 276px;
      padding-right: var(--gutter);
    }
    .product-carousel__image-wrap {
      height: 270px;
    }
  }
</style>
