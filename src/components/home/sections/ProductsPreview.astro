---
import SectionHeading from "../../ui/SectionHeading.astro";
import ProductCarousel from "../ProductCarousel.astro";
---

<section class="products section section-divider">
  <div class="container">
    <div class="products__head">
      <SectionHeading
        eyebrow="Nasze produkty"
        title="Cztery produkty na początek"
      />
      <div>
        <p class="prose">
          Strona główna prezentuje cztery miody. Pełny katalog obejmuje także
          produkty pszczele i ziołomiody, pogrupowane dla łatwiejszego wyboru.
        </p>
        <a class="text-link" href="/produkty">
          Odkryj nasze produkty <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <ProductCarousel />
  </div>
</section>
<style>
  .products__head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-grid);
    align-items: end;
  }

  .products__head :global(h2) {
    max-width: 19ch;
  }

  .products__head > div {
    max-width: 44ch;
    justify-self: end;
  }

  .text-link {
    margin-top: var(--space-2);
  }

  @media (max-width: 899px) {
    .products__head {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .products__head > div {
      justify-self: start;
      max-width: 56ch;
    }
  }
</style>
