---
import SectionHeading from "../ui/SectionHeading.astro";

const steps = [
  {
    number: "01",
    title: "Różnorodne pożytki",
    text: "Każde miejsce i pora kwitnienia nadają miodowi własny smak oraz aromat.",
  },
  {
    number: "02",
    title: "Troska o pszczoły",
    text: "Codzienna uważność na potrzeby pszczół prowadzi nas przez cały sezon.",
  },
  {
    number: "03",
    title: "Naturalny charakter miodu",
    text: "Barwa, zapach i konsystencja zmieniają się wraz z tym, co przynosi natura.",
  },
];
---

<section
  class="editorial section--sm section-divider"
  aria-labelledby="editorial-title"
>
  <div class="container">
    <div class="editorial__head">
      <SectionHeading
        eyebrow="Od natury do słoika"
        title="Prosta droga, uważna praca"
      />
      <a class="text-link" href="/o-pasiece">
        Poznaj naszą pasiekę <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol class="editorial__steps">
      {steps.map((step) => (
        <li data-reveal>
          <span class="editorial__number" aria-hidden="true">
            {step.number}
          </span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .editorial__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-grid);
  }

  .editorial__head :global(h2) {
    max-width: 17ch;
  }

  .editorial__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }

  .editorial__steps li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border);
  }

  .editorial__number {
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .editorial h3 {
    font-size: var(--text-card-title);
  }

  .editorial p {
    max-width: 28ch;
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  @media (max-width: 899px) {
    .editorial__steps {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  @media (max-width: 639px) {
    .editorial__head {
      display: block;
    }

    .editorial__head .text-link {
      margin-top: var(--space-3);
    }
  }
</style>
