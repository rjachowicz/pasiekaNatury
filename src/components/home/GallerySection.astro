---
const photos = [
  { file: 'gallery-bee.jpg', alt: 'Pszczoła zbierająca nektar z kwiatu' },
  { file: 'gallery-honey.jpg', alt: 'Złocisty miód spływający z nabieraka do słoika' },
  { file: 'gallery-comb.jpg', alt: 'Pszczoły pracujące na plastrze miodu' },
];
---
<section class="gallery" aria-label="Z bliska — życie naszej pasieki">
  {photos.map(({ file, alt }) => <img src={`/assets/${file}`} width="623" height="623" loading="lazy" alt={alt} />)}
</section>
<style>
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding-top: 8px; }
  .gallery img { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; }
  @media (max-width: 767px) { .gallery { grid-template-columns: 1fr; } .gallery img { aspect-ratio: 4 / 3; } }
</style>
