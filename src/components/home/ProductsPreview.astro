---
import SectionHeading from "../ui/SectionHeading.astro";
import ProductCarousel from "./ProductCarousel.astro";
---

<section class="products section section-divider">
  <div class="container">
    <div class="products__head">
      <SectionHeading
        eyebrow="Nasze produkty"
        title="Naturalne smaki prosto z pasieki"
      />
      <div>
        <p class="prose">
          Oferujemy miody z różnych pożytków, każdy o wyjątkowym smaku, aromacie
          i charakterze. Poznaj cztery smaki naszej pasieki.
        </p>
        <a class="text-link" href="/produkty">
          Odkryj nasze miody <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <ProductCarousel />
  </div>
</section>
<style>
  .products {
    position: relative;
    isolation: isolate;
  }

  .products::before {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 260px;
    height: 280px;
    z-index: -1;
    background: url("/assets/honeycomb.png") left bottom / 480px auto no-repeat;
    opacity: 0.045;
    mask-image: linear-gradient(225deg, #000, transparent 75%);
    pointer-events: none;
  }

  .products__head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-grid);
    align-items: end;
  }

  .products__head :global(h2) {
    max-width: 19ch;
  }

  .products__head > div {
    max-width: 44ch;
    justify-self: end;
  }

  .text-link {
    margin-top: var(--space-2);
  }

  @media (max-width: 899px) {
    .products__head {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .products__head > div {
      justify-self: start;
      max-width: 56ch;
    }
  }
</style>
