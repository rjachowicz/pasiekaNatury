---
import AssetImage from '../AssetImage.astro';
import SectionHeading from '../SectionHeading.astro';
import { products } from '../../data/site';
---
<section class="products section">
  <div class="container">
    <div class="products__head">
      <SectionHeading eyebrow="Nasze produkty" title="Naturalne smaki prosto z pasieki" />
      <div>
        <p class="prose">Oferujemy miody z różnych pożytków, każdy o wyjątkowym smaku, aromacie i charakterze. Poznaj cztery smaki naszej pasieki.</p>
        <a class="text-link" href="/produkty">Odkryj nasze miody <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="products__collection">
      <AssetImage class="products__image" sizes="(max-width: 1200px) 92vw, 1120px" src="/assets/products.png" loading="lazy" alt="Cztery słoiki: miód faceliowy, lipowy, gryczany i spadziowy" />
      <div class="products__labels">
        {products.map((product, index) => <article class="product-label">
          <span class="product-label__number" aria-hidden="true">0{index + 1}</span>
          <div><h3><a href={`/produkty#${product.id}`}>{product.name}<span class="product-label__arrow" aria-hidden="true">↗</span></a></h3><p>{product.description}</p></div>
        </article>)}
      </div>
    </div>
  </div>
</section>
<style>
  .products { position: relative; isolation: isolate; }
  .products::before { content: ''; position: absolute; inset: 0; z-index: -1; background: url('/assets/honeycomb.png') right center / 900px auto no-repeat; opacity: .035; pointer-events: none; }
  .products__head { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-grid); align-items: end; }
  .products__head :global(h2) { max-width: 19ch; }
  .products__head > div { max-width: 44ch; justify-self: end; }
  .text-link { margin-top: var(--space-2); }
  .products__collection { width: min(100%, 1120px); margin: var(--space-5) auto 0; }
  .products__image { width: 100%; }
  .products__labels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: var(--space-3); }
  .product-label { padding-inline: 12px; text-align: center; }
  .product-label__number, .product-label__arrow { display: none; }
  .product-label h3 { font-size: clamp(1.5rem, 2.1vw, 1.9rem); }
  .product-label a { display: inline-flex; align-items: center; min-height: 44px; }
  .product-label a:hover { text-decoration: underline; text-decoration-color: var(--color-primary); text-underline-offset: 6px; }
  .product-label p { max-width: 25ch; margin: var(--space-1) auto 0; color: var(--color-muted); font-size: var(--text-small); }
  @media (max-width: 999px) {
    .products__labels { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-4); }
    .product-label { display: flex; gap: var(--space-2); padding: var(--space-2) 0 0; border-top: 1px solid var(--color-border); text-align: left; }
    .product-label__number { display: block; padding-top: 12px; color: var(--color-muted); font-size: .75rem; }
    .product-label h3 { font-size: 1.75rem; }
    .product-label__arrow { display: inline; margin-left: 12px; font: 400 1rem var(--font-sans); }
    .product-label p { max-width: 32ch; margin: 4px 0 0; }
  }
  @media (max-width: 899px) {
    .products__head { grid-template-columns: 1fr; gap: var(--space-3); }
    .products__head > div { justify-self: start; max-width: 56ch; }
  }
  @media (max-width: 639px) {
    .products__collection { margin-top: var(--space-4); }
    .products__labels { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
