---
import AssetImage from '../AssetImage.astro';
const values = [
  { title: '100% natury', description: 'Czyste tereny i naturalne pożytki.', icon: 'icon-maple.png' },
  { title: 'Szacunek do pszczół', description: 'Troska o pszczoły i dobre warunki w ulu.', icon: 'icon-heart.png' },
  { title: 'Wędrowna pasieka', description: 'Podążamy za kwitnieniem i różnorodnością natury.', icon: null },
  { title: 'Tradycja i jakość', description: 'Pszczelarskie rzemiosło i uważność na każdym etapie.', icon: 'icon-honey.png' },
];
---
<section class="values section section-divider" aria-label="Nasze wartości">
  <h2 class="sr-only">Nasze wartości</h2>
  <div class="container values__grid" data-reveal-group>
    {values.map((value) => <article class="value" data-reveal>
      <div class="value__hex" aria-hidden="true"><div class="value__icon">
        {value.icon ? <AssetImage src={`/assets/${value.icon}`} loading="lazy" alt="" aria-hidden="true" /> : <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 5 18 23h9L15 38h11L17 51h30L38 38h11L37 23h9L32 5Z"/><path d="M29 50h6v10h-6z"/></svg>}
      </div></div>
      <h3>{value.title}</h3><p>{value.description}</p>
    </article>)}
  </div>
</section>
<style>
  .values__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .value { display: flex; flex-direction: column; align-items: center; padding: 0 var(--space-3); text-align: center; border-right: 1px solid var(--color-border); }
  .value:last-child { border-right: 0; }
  .value__hex { display: grid; place-items: center; width: 72px; height: 64px; margin-bottom: var(--space-3); background: var(--color-primary); clip-path: var(--hexagon); }
  .value__icon { display: grid; place-items: center; width: 69px; height: 61px; background: var(--color-white); clip-path: inherit; }
  .value__icon img, .value__icon svg { width: 35px; height: 35px; object-fit: contain; fill: var(--color-primary); }
  h3 { max-width: 20ch; font: 600 .8125rem/1.45 var(--font-sans); text-transform: uppercase; letter-spacing: .025em; }
  p { max-width: 26ch; margin-top: 12px; color: var(--color-muted); font-size: var(--text-small); }
  @media (max-width: 999px) {
    .values__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-5); }
    .value:nth-child(2) { border-right: 0; }
  }
  @media (max-width: 599px) {
    .values__grid { grid-template-columns: 1fr; gap: var(--space-3); }
    .value { display: grid; grid-template-columns: 64px minmax(0, 1fr); column-gap: var(--space-3); padding: 0 0 var(--space-3); border-right: 0; border-bottom: 1px solid var(--color-border); text-align: left; }
    .value:last-child { border-bottom: 0; padding-bottom: 0; }
    .value__hex { grid-row: span 2; width: 64px; height: 57px; margin: 0; }
    .value__icon { width: 61px; height: 54px; }
    h3 { max-width: none; align-self: end; }
    p { margin-top: 6px; align-self: start; }
  }
</style>
