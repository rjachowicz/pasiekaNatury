---
import AssetImage from "../ui/AssetImage.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
---

<section class="about">
  <div class="about__copy">
    <SectionHeading eyebrow="O pasiece" light>
      Z pasji do pszczół
      <br />i natury
    </SectionHeading>
    <p>
      Pasieka 100% Natury to miejsce, w którym pszczelarskie rzemiosło łączy się
      z miłością do natury. Dbamy o pszczoły i wybieramy różnorodne pożytki, by
      dzielić się tym, co w miodzie najlepsze.
    </p>
    <div data-reveal>
      <Button href="/o-pasiece">Nasza historia</Button>
    </div>
  </div>
  <figure class="about__visual">
    <AssetImage
      src="/assets/beekeeper.jpg"
      sizes="(max-width: 639px) 640px, (max-width: 899px) 100vw, max(50vw, 1000px)"
      loading="lazy"
      alt="Pszczelarz oglądający ramkę z pszczołami w słonecznej pasiece"
    />
    <figcaption>
      Pszczoły uczą
      <br />
      pokory do natury.
    </figcaption>
  </figure>
</section>
<style>
  .about {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    background: var(--color-dark);
    color: var(--color-white);
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px var(--space-grid) 48px var(--page-inset);
  }

  .about__copy > p {
    max-width: 44ch;
    margin-block: var(--space-3) var(--space-4);
    color: var(--color-on-dark);
  }

  .about__visual {
    position: relative;
    min-width: 0;
    height: 560px;
    overflow: hidden;
    border-radius: 0;
  }

  .about__visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-dark),
      var(--color-dark-72) 22%,
      transparent 44%
    );
  }

  .about__visual img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 32% center;
  }

  figcaption {
    position: absolute;
    z-index: 1;
    right: var(--space-4);
    bottom: var(--space-4);
    padding-right: var(--space-2);
    border-right: 2px solid var(--color-primary);
    color: var(--color-white);
    font: italic 500 var(--text-card-title)/1.15 var(--font-heading);
    text-align: right;
  }

  @media (max-width: 899px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__copy {
      padding: var(--space-section) var(--gutter);
    }

    .about__copy > p {
      max-width: 56ch;
    }

    .about__visual::after {
      background: linear-gradient(
        180deg,
        var(--color-dark),
        var(--color-dark-72) 24%,
        transparent 44%
      );
    }

    .about__visual {
      height: 400px;
      border-radius: 0;
    }

    .about__visual img {
      object-position: 30% center;
    }
  }
</style>
