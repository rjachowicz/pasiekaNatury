---
import AssetImage from "../ui/AssetImage.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="apiary">
  <AssetImage
    class="apiary__image"
    sizes="(max-width: 899px) 1440px, 100vw"
    src="/assets/apiary.jpg"
    loading="lazy"
    alt="Ule na kwitnącej łące z górami i lasem w tle"
  />
  <div class="container apiary__content">
    <SectionHeading eyebrow="Wędrowna pasieka" light>
      Z naturą
      <br />w najlepszych miejscach
    </SectionHeading>
    <p>
      Nasza pasieka wędruje w poszukiwaniu różnorodnych, bogatych pożytków. Rytm
      kwitnienia wyznacza kolejne przystanki, a każde miejsce nadaje miodom
      wyjątkowy charakter i smak.
    </p>
  </div>
</section>
<style>
  .apiary {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    height: 520px;
    padding-block: 48px;
    background: var(--color-dark);
    color: var(--color-white);
  }

  .apiary__image {
    position: absolute;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 65%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, #000 0%, #000 65%, transparent 100%);
  }

  .apiary::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      90deg,
      #172016e6 0%,
      #172016b8 35%,
      #17201655 58%,
      #17201608 100%
    );
  }

  .apiary__content :global(h2) {
    max-width: 15ch;
    font-size: var(--text-section-title);
  }

  .apiary__content > p {
    max-width: 39ch;
    margin-top: var(--space-3);
    font-size: var(--text-body);
  }

  @media (max-width: 899px) {
    .apiary {
      align-items: end;
      padding-block: var(--space-section-sm);
    }

    .apiary::before {
      background: linear-gradient(
        0deg,
        #172016ed,
        #172016b8 52%,
        #17201608 100%
      );
    }

    .apiary__image {
      object-position: 62% center;
      -webkit-mask-image: linear-gradient(
        180deg,
        #000 0%,
        #000 66%,
        transparent 100%
      );
      mask-image: linear-gradient(180deg, #000 0%, #000 66%, transparent 100%);
    }

    .apiary__content > p {
      max-width: 46ch;
    }
  }

  @media (max-width: 639px) {
    .apiary {
      height: 480px;
    }

    .apiary__image {
      object-position: 64% center;
    }
  }
</style>
