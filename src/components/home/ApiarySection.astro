---
import AssetImage from "../ui/AssetImage.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="apiary">
  <AssetImage
    class="apiary__image"
    sizes="100vw"
    src="/assets/rape.jpg"
    widths={[640, 960, 1440]}
    loading="lazy"
    alt="Ule na kwitnącej łące z górami i lasem w tle"
  />
  <div class="container apiary__content">
    <SectionHeading eyebrow="Wędrowna pasieka" light>
      Z naturą
      <br />w najlepszych miejscach
    </SectionHeading>
    <p>
      Nasza pasieka wędruje w poszukiwaniu różnorodnych, bogatych pożytków. Rytm
      kwitnienia wyznacza kolejne przystanki, a każde miejsce nadaje miodom
      wyjątkowy charakter i smak.
    </p>
  </div>
</section>
<style>
  .apiary {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    height: 520px;
    margin: 0;
    padding-block: 48px;
    background: var(--color-dark);
    color: var(--color-white);
    overflow: hidden;
  }

  .apiary__image {
    position: absolute;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }

  .apiary::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-forest-90) 0%,
      var(--color-forest-72) 35%,
      var(--color-forest-33) 58%,
      var(--color-forest-3) 100%
    );
  }

  .apiary__content :global(h2) {
    max-width: 15ch;
    font-size: var(--text-section-title);
  }

  .apiary__content > p {
    max-width: 39ch;
    margin-top: var(--space-3);
    font-size: var(--text-body);
  }

  @media (max-width: 899px) {
    .apiary {
      align-items: end;
      height: 480px;
      padding-block: var(--space-section-sm);
    }

    .apiary::before {
      background: linear-gradient(
        0deg,
        var(--color-forest-93),
        var(--color-forest-72) 52%,
        var(--color-forest-3) 100%
      );
    }

    .apiary__image {
      object-position: 62% center;
    }

    .apiary__content > p {
      max-width: 46ch;
    }
  }

  @media (max-width: 639px) {
    .apiary {
      height: 420px;
      margin-inline: var(--gutter);
    }

    .apiary__image {
      object-position: 64% center;
    }
  }
</style>
