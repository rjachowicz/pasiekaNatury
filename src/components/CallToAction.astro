---
import Button from './Button.astro';
interface Props { title: string; href: string; label: string; }
const { title, href, label } = Astro.props;
---
<section class="cta-section section">
  <div class="container cta-section__inner">
    <div><h2>{title}</h2><div class="prose"><slot /></div></div>
    <Button href={href}>{label}</Button>
  </div>
</section>
<style>
  .cta-section { background: var(--color-soft); }
  .cta-section__inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .prose { margin-top: 20px; }
  .cta-section__inner > :global(.button) { flex-shrink: 0; }
  @media (max-width: 767px) { .cta-section__inner { flex-direction: column; align-items: flex-start; } }
</style>
