---
import AssetImage from './AssetImage.astro';
interface Props { eyebrow: string; title: string; }
const { eyebrow, title } = Astro.props;
---
<section class="page-hero">
  <div class="container page-hero__inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <span class="accent-line" aria-hidden="true"></span>
      <div class="prose"><slot /></div>
    </div>
    <div class="page-hero__motif" aria-hidden="true">
      <span class="page-hero__hex"></span>
      <AssetImage src="/assets/bee-flight.png" widths={[160, 320]} sizes="160px" alt="" />
      <span class="eyebrow">Blisko natury</span>
    </div>
  </div>
</section>
<style>
  .page-hero { position: relative; isolation: isolate; padding-block: var(--space-section-sm); background: var(--color-soft); border-bottom: 1px solid var(--color-border); }
  .page-hero::before { content: ''; position: absolute; z-index: -1; inset: 0; background: url('/assets/honeycomb.png') right center / auto 100% no-repeat; opacity: .045; pointer-events: none; }
  .page-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) 240px; align-items: center; gap: var(--space-grid); }
  .eyebrow { margin-bottom: var(--space-2); }
  h1 { max-width: 20ch; font-size: clamp(2.8rem, 2rem + 2.7vw, 4.6rem); }
  .prose { max-width: 57ch; }
  .accent-line { margin-block: var(--space-3); }
  .page-hero__motif { position: relative; display: grid; place-items: center; min-height: 200px; gap: var(--space-2); align-content: center; }
  .page-hero__hex { position: absolute; inset: 0; background: var(--color-border); clip-path: var(--hexagon); }
  .page-hero__hex::after { content: ''; position: absolute; inset: 1px; clip-path: inherit; background: var(--color-soft); }
  .page-hero__motif img { position: relative; width: 180px; opacity: .7; }
  .page-hero__motif .eyebrow { position: relative; margin: 0; font-size: .625rem; color: var(--color-muted); }
  @media (max-width: 899px) {
    .page-hero__inner { grid-template-columns: minmax(0, 1fr) 160px; gap: var(--space-4); }
    .page-hero__motif { min-height: 140px; }
    .page-hero__motif img { width: 130px; }
  }
  @media (max-width: 639px) {
    .page-hero { padding-block: 48px 40px; }
    .page-hero__inner { grid-template-columns: 1fr; }
    .page-hero__motif { display: none; }
  }
</style>
