---
import Icon, { type IconName } from "../ui/Icon.astro";

const values = [
  {
    title: "Szacunek do pszczół",
    description: "Troska o pszczoły i dobre warunki w ulu.",
    icon: "heart",
  },
  {
    title: "Obserwacja natury",
    description: "Uważność na to, co przynosi każda pora roku.",
    icon: "leaf",
  },
  {
    title: "Różnorodne pożytki",
    description: "Wędrujemy za kwitnieniem i bogactwem roślin.",
    icon: "tree",
  },
  {
    title: "Pszczelarskie rzemiosło",
    description: "Cierpliwość i rzetelność obecne na każdym etapie pracy.",
    icon: "honey-jar",
  },
] satisfies { title: string; description: string; icon: IconName }[];
---

<section class="values section" aria-labelledby="values-title">
  <div class="container">
    <div class="values__heading">
      <p class="eyebrow">Wartości</p>
      <h2 id="values-title">To, co jest dla nas ważne</h2>
    </div>
    <div class="values__grid">
      {values.map((value) => (
        <article class="value">
          <div class="value__icon">
            <Icon name={value.icon} size={34} />
          </div>
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .values {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(
        circle at 92% 16%,
        var(--color-primary-25),
        transparent 19rem
      ),
      var(--color-white);
  }
  .values__heading {
    max-width: 500px;
    margin-bottom: var(--space-5);
  }
  .values__heading h2 {
    margin-top: var(--space-2);
  }
  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .value {
    min-height: 292px;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-subtle);
  }
  .value__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    background: var(--color-soft);
  }
  .value h3 {
    font-size: var(--text-card-title);
  }
  .value p {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  @media (max-width: 899px) {
    .values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .value {
      min-height: 232px;
    }
  }
  @media (max-width: 479px) {
    .values__grid {
      grid-template-columns: 1fr;
    }
    .value {
      min-height: 0;
    }
  }
</style>
