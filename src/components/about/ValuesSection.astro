---
import ValueIcon, { type ValueIconName } from "../ui/ValueIcon.astro";

const values = [
  {
    title: "Szacunek do pszczół",
    description: "Troska o pszczoły i dobre warunki w ulu.",
    icon: "heart",
  },
  {
    title: "Obserwacja natury",
    description: "Uważność na to, co przynosi każda pora roku.",
    icon: "leaf",
  },
  {
    title: "Różnorodne pożytki",
    description: "Wędrujemy za kwitnieniem i bogactwem roślin.",
    icon: "tree",
  },
  {
    title: "Pszczelarskie rzemiosło",
    description: "Cierpliwość i rzetelność obecne na każdym etapie pracy.",
    icon: "honey-jar",
  },
] satisfies { title: string; description: string; icon: ValueIconName }[];
---

<section class="values section" aria-labelledby="values-title">
  <div class="container">
    <div class="values__heading">
      <p class="eyebrow">Wartości</p>
      <h2 id="values-title">To, co jest dla nas ważne</h2>
    </div>
    <div class="values__grid">
      {values.map((value) => (
        <article class="value" data-reveal>
          <ValueIcon name={value.icon} />
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .values {
    background: var(--color-background);
  }

  .values__heading {
    max-width: 500px;
    margin-bottom: var(--space-5);
  }

  .values__heading h2 {
    margin-top: var(--space-2);
  }

  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .value {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3) var(--space-3) var(--space-4);
    text-align: center;
  }

  .value:not(:first-child)::before {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 0;
    width: 1px;
    background: var(--color-border);
    content: "";
  }

  .value :global(.value-icon) {
    width: 76px;
    margin-bottom: var(--space-3);
  }

  .value h3 {
    display: grid;
    min-height: calc(var(--text-card-title) * 2.1);
    place-items: center;
    font-size: var(--text-card-title);
  }

  .value p {
    max-width: 25ch;
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  @media (max-width: 899px) {
    .values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .value {
      padding-block: var(--space-3);
    }

    .value:nth-child(odd)::before {
      display: none;
    }

    .value:nth-child(n + 3) {
      border-top: var(--border);
    }
  }

  @media (max-width: 479px) {
    .values__grid {
      grid-template-columns: 1fr;
    }

    .value {
      padding-block: var(--space-4);
    }

    .value:not(:first-child)::before {
      display: none;
    }

    .value:not(:first-child) {
      border-top: var(--border);
    }
  }
</style>
