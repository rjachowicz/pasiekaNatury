---
import FeatureTile from "../../ui/FeatureTile.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<section class="bees-focus section">
  <div class="container">
    <div class="bees-focus__heading">
      <SectionHeading
        eyebrow="U podstaw"
        title="Pszczoły w centrum naszej pracy"
      />
      <p>
        Każda decyzja w pasiece zaczyna się od troski o pszczelą rodzinę i
        środowisko, w którym żyje.
      </p>
    </div>
    <div class="feature-grid">
      <FeatureTile
        index={0}
        icon="hand-stars"
        title="Szacunek do pszczół"
        description="Spokój i obserwacja pomagają dostrzegać potrzeby pszczelej rodziny."
      />
      <FeatureTile
        index={1}
        icon="bee"
        title="Różnorodność pożytków"
        description="Szukamy miejsc, w których natura daje pszczołom różne źródła nektaru i pyłku."
      />
      <FeatureTile
        index={2}
        icon="sun"
        title="Sezonowe rzemiosło"
        description="Rytm prac wyznaczają pory roku oraz to, co w danym czasie dzieje się w ulu."
      />
    </div>
  </div>
</section>

<style>
  .bees-focus {
    background: var(--color-background);
  }
  .bees-focus__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-grid);
    margin-bottom: var(--space-4);
  }
  .bees-focus__heading > p {
    max-width: 42ch;
    color: var(--color-muted);
  }
  @media (max-width: 639px) {
    .bees-focus__heading {
      display: block;
    }
    .bees-focus__heading > p {
      margin-top: var(--space-2);
    }
  }
</style>
