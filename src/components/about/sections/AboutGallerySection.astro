---
import { getImage } from "astro:assets";
import AssetImage from "../../ui/AssetImage.astro";
import { imageAssets, type ImageAssetPath } from "../../../data/imageAssets";

const gallery: {
  className: string;
  src: ImageAssetPath;
  alt: string;
  sizes: string;
  widths: number[];
  position: string;
}[] = [
  {
    className: "photo-story__bee",
    src: "/assets/hives.png",
    alt: "Rząd kolorowych uli",
    sizes: "(max-width: 639px) calc((100vw - 48px) / 2), 24vw",
    widths: [320, 480, 640, 960],
    position: "20% center",
  },
  {
    className: "photo-story__honey",
    src: "/assets/winter_apiary.png",
    alt: "Ule pokryte śniegiem",
    sizes: "(max-width: 639px) calc((100vw - 48px) / 2), 40vw",
    widths: [320, 640, 960, 1280],
    position: "center 52%",
  },
  {
    className: "photo-story__comb",
    src: "/assets/bee_brood.png",
    alt: "Ramka z czerwiem i pszczołami",
    sizes: "(max-width: 639px) calc((100vw - 48px) / 2), 32vw",
    widths: [320, 640, 960],
    position: "center 52%",
  },
  {
    className: "photo-story__apiary",
    src: "/assets/bees_hive.png",
    alt: "Pszczoły na ulach w rzepaku",
    sizes: "(max-width: 639px) calc(100vw - 40px), 72vw",
    widths: [480, 960, 1440, 1920],
    position: "center 57%",
  },
];
const galleryWithLightbox = await Promise.all(
  gallery.map(async (item) => ({
    ...item,
    lightboxImage: await getImage({
      src: imageAssets[item.src],
      width: Math.min(2400, imageAssets[item.src].width),
      format: "webp",
      quality: 82,
    }),
  })),
);
---

<section class="photo-story section--sm" aria-labelledby="photo-story-title">
  <div class="container">
    <div class="photo-story__heading">
      <p class="eyebrow">Codzienność pasieki</p>
      <h2 id="photo-story-title">Natura w zbliżeniu</h2>
    </div>
    <div class="photo-story__grid">
      {galleryWithLightbox.map(
        ({ className, src, alt, sizes, widths, position, lightboxImage }) => (
          <figure class={className}>
            <button
              class="image-zoom-trigger"
              type="button"
              data-lightbox-src={lightboxImage.src}
              data-lightbox-alt={alt}
              data-lightbox-group="about-gallery"
              aria-haspopup="dialog"
              aria-label={`Powiększ zdjęcie: ${alt}`}
            >
              <AssetImage
                src={src}
                widths={widths}
                sizes={sizes}
                loading="lazy"
                alt={alt}
                style={`--photo-story-image-position: ${position}`}
              />
              <span class="image-zoom-trigger__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                >
                  <circle cx="10.5" cy="10.5" r="5.5"></circle>
                  <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5"></path>
                </svg>
              </span>
            </button>
          </figure>
        ),
      )}
    </div>
  </div>
</section>

<style>
  .image-zoom-trigger {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .image-zoom-trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-story-image-position);
  }
  .image-zoom-trigger__icon {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    color: var(--color-white);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .image-zoom-trigger__icon svg {
    width: 32px;
    height: 32px;
  }
  .image-zoom-trigger:hover .image-zoom-trigger__icon,
  .image-zoom-trigger:focus-visible .image-zoom-trigger__icon {
    opacity: 1;
  }
  .photo-story {
    padding-bottom: var(--space-section);
    background: var(--color-soft);
  }
  .photo-story__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .photo-story__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 230px 310px;
    gap: var(--space-2);
  }
  .photo-story figure {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  .photo-story figure:hover {
    box-shadow: var(--shadow-subtle);
    transform: translateY(-2px);
  }
  .photo-story__bee {
    grid-column: 1 / 4;
    grid-row: 1 / 3;
  }
  .photo-story__honey {
    grid-column: 4 / 9;
    grid-row: 1;
  }
  .photo-story__comb {
    grid-column: 9 / 13;
    grid-row: 1;
  }
  .photo-story__apiary {
    grid-column: 4 / 13;
    grid-row: 2;
  }
  @media (max-width: 639px) {
    .photo-story__heading {
      display: block;
    }
    .photo-story__heading h2 {
      margin-top: var(--space-2);
    }
    .photo-story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 220px 170px 250px;
      gap: var(--space-1);
    }
    .photo-story__bee {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .photo-story__honey {
      grid-column: 2;
      grid-row: 1;
    }
    .photo-story__comb {
      grid-column: 2;
      grid-row: 2;
    }
    .photo-story__apiary {
      grid-column: 1 / 3;
      grid-row: 3;
    }
  }
</style>
