---
import AssetImage from "../../ui/AssetImage.astro";
import { imageAssets } from "../../../data/imageAssets";
---

<section class="photo-story section--sm" aria-labelledby="photo-story-title">
  <div class="container">
    <div class="photo-story__heading">
      <p class="eyebrow">Codzienność pasieki</p>
      <h2 id="photo-story-title">Natura w zbliżeniu</h2>
    </div>
    <div class="photo-story__grid">
      <figure class="photo-story__bee">
        <button
          class="image-zoom-trigger"
          type="button"
          data-lightbox-src={imageAssets["/assets/gallery-bee.jpg"].src}
          data-lightbox-alt="Pszczoła zbierająca nektar z kwiatu"
          data-lightbox-group="about-gallery"
          aria-haspopup="dialog"
          aria-label="Powiększ zdjęcie: Pszczoła zbierająca nektar z kwiatu"
        >
          <AssetImage
            src="/assets/gallery-bee.jpg"
            widths={[320, 640, 960]}
            sizes="(max-width: 639px) 92vw, 28vw"
            loading="lazy"
            alt="Pszczoła zbierająca nektar z kwiatu"
          />
          <span class="image-zoom-trigger__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="5.5"></circle>
              <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5"></path>
            </svg>
          </span>
        </button>
      </figure>
      <figure class="photo-story__honey">
        <button
          class="image-zoom-trigger"
          type="button"
          data-lightbox-src={imageAssets["/assets/gallery-honey.jpg"].src}
          data-lightbox-alt="Złocisty miód spływający do słoika"
          data-lightbox-group="about-gallery"
          aria-haspopup="dialog"
          aria-label="Powiększ zdjęcie: Złocisty miód spływający do słoika"
        >
          <AssetImage
            src="/assets/gallery-honey.jpg"
            widths={[320, 640, 960]}
            sizes="(max-width: 639px) 92vw, 48vw"
            loading="lazy"
            alt="Złocisty miód spływający do słoika"
          />
          <span class="image-zoom-trigger__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="5.5"></circle>
              <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5"></path>
            </svg>
          </span>
        </button>
      </figure>
      <figure class="photo-story__comb">
        <button
          class="image-zoom-trigger"
          type="button"
          data-lightbox-src={imageAssets["/assets/gallery-comb.jpg"].src}
          data-lightbox-alt="Pszczoły pracujące na plastrze miodu"
          data-lightbox-group="about-gallery"
          aria-haspopup="dialog"
          aria-label="Powiększ zdjęcie: Pszczoły pracujące na plastrze miodu"
        >
          <AssetImage
            src="/assets/gallery-comb.jpg"
            widths={[320, 640, 960]}
            sizes="(max-width: 639px) 92vw, 30vw"
            loading="lazy"
            alt="Pszczoły pracujące na plastrze miodu"
          />
          <span class="image-zoom-trigger__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="5.5"></circle>
              <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5"></path>
            </svg>
          </span>
        </button>
      </figure>
      <figure class="photo-story__apiary">
        <button
          class="image-zoom-trigger"
          type="button"
          data-lightbox-src={imageAssets["/assets/apiary.jpg"].src}
          data-lightbox-alt="Ule na łące z górami i lasem w tle"
          data-lightbox-group="about-gallery"
          aria-haspopup="dialog"
          aria-label="Powiększ zdjęcie: Ule na łące z górami i lasem w tle"
        >
          <AssetImage
            src="/assets/apiary.jpg"
            widths={[320, 640, 960]}
            sizes="(max-width: 639px) 92vw, 70vw"
            loading="lazy"
            alt="Ule na łące z górami i lasem w tle"
          />
          <span class="image-zoom-trigger__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="5.5"></circle>
              <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5"></path>
            </svg>
          </span>
        </button>
      </figure>
    </div>
  </div>
</section>

<style>
  .image-zoom-trigger {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .image-zoom-trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-zoom-trigger__icon {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    color: var(--color-white);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .image-zoom-trigger__icon svg {
    width: 32px;
    height: 32px;
  }
  .image-zoom-trigger:hover .image-zoom-trigger__icon,
  .image-zoom-trigger:focus-visible .image-zoom-trigger__icon {
    opacity: 1;
  }
  .photo-story {
    padding-bottom: var(--space-section);
    background: var(--color-soft);
  }
  .photo-story__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .photo-story__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 230px 310px;
    gap: var(--space-2);
  }
  .photo-story figure {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  .photo-story figure:hover {
    box-shadow: var(--shadow-subtle);
    transform: translateY(-2px);
  }
  .photo-story :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-story__bee {
    grid-column: 1 / 4;
    grid-row: 1 / 3;
  }
  .photo-story__honey {
    grid-column: 4 / 9;
    grid-row: 1;
  }
  .photo-story__comb {
    grid-column: 9 / 13;
    grid-row: 1;
  }
  .photo-story__apiary {
    grid-column: 4 / 13;
    grid-row: 2;
  }
  @media (max-width: 639px) {
    .photo-story__heading {
      display: block;
    }
    .photo-story__heading h2 {
      margin-top: var(--space-2);
    }
    .photo-story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 220px 170px 250px;
      gap: var(--space-1);
    }
    .photo-story__bee {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .photo-story__honey {
      grid-column: 2;
      grid-row: 1;
    }
    .photo-story__comb {
      grid-column: 2;
      grid-row: 2;
    }
    .photo-story__apiary {
      grid-column: 1 / 3;
      grid-row: 3;
    }
  }
</style>
