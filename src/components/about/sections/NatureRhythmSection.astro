---
import AssetImage from "../../ui/AssetImage.astro";
---

<section class="nature-rhythm">
  <div class="nature-rhythm__image">
    <AssetImage
      src="/assets/bee-field.png"
      widths={[640, 960, 1440]}
      sizes="(max-width: 899px) 100vw, 58vw"
      loading="lazy"
      alt="Wędrowna pasieka wśród łąk i gór"
    />
  </div>
  <div class="nature-rhythm__copy">
    <p class="eyebrow eyebrow--line">Wędrowna pasieka</p>
    <h2>Za pożytkami przez cały sezon</h2>
    <span class="accent-line" aria-hidden="true"></span>
    <p>
      Po powrocie w 2012 roku Kazimierz Sowa zaczął rozwijać własną pasiekę od
      20 zakupionych uli. Dziś liczy ona około 70 rodzin pszczelich i wędruje za
      nawłocią, lipą, gryką, facelią, spadzią oraz pożytkami wielokwiatowymi.
    </p>
  </div>
</section>

<style>
  .nature-rhythm {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    min-height: 560px;
    background: var(--color-dark);
    color: var(--color-white);
  }
  .nature-rhythm__image {
    position: relative;
    min-height: 100%;
    overflow: hidden;
  }
  .nature-rhythm__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }
  .nature-rhythm__image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 30%, var(--color-dark) 100%);
    content: "";
    pointer-events: none;
  }
  .nature-rhythm__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-section-sm) var(--page-inset) var(--space-section-sm)
      var(--space-grid);
  }
  .nature-rhythm__copy h2 {
    max-width: 12ch;
    font-size: var(--text-section-title);
  }
  .nature-rhythm__copy > p:last-child {
    max-width: 42ch;
    color: var(--color-on-dark);
  }
  @media (max-width: 899px) {
    .nature-rhythm {
      grid-template-columns: 1fr;
    }
    .nature-rhythm__image {
      min-height: 380px;
    }
    .nature-rhythm__image::after {
      background: linear-gradient(0deg, var(--color-dark), transparent 52%);
    }
    .nature-rhythm__copy {
      padding: var(--space-section-sm) var(--gutter);
    }
  }
  @media (max-width: 639px) {
    .nature-rhythm__image {
      min-height: 300px;
    }
  }
</style>
