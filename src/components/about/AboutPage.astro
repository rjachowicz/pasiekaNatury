---
import CallToAction from "../ui/CallToAction.astro";
import PageHero from "../ui/PageHero.astro";
import AboutGallerySection from "./sections/AboutGallerySection.astro";
import AboutQuoteSection from "./sections/AboutQuoteSection.astro";
import AboutStorySection from "./sections/AboutStorySection.astro";
import BeesFocusSection from "./sections/BeesFocusSection.astro";
import NatureRhythmSection from "./sections/NatureRhythmSection.astro";
import ValuesSection from "./sections/ValuesSection.astro";
---

<>
  <PageHero
    eyebrow="O pasiece"
    title="Rodzinna pasieka wielu pokoleń"
    image="/assets/apiary.jpg"
    imageAlt="Ule stojące na łące przy pasiece"
  >
    <p>
      Pasiekę 100% Natury prowadzi dziś Kazimierz Sowa, rozwijając rodzinne
      pszczelarstwo przy wsparciu żony i dzieci.
    </p>
  </PageHero>

  <AboutStorySection />
  <AboutGallerySection />
  <BeesFocusSection />
  <NatureRhythmSection />
  <AboutQuoteSection />
  <ValuesSection />

  <CallToAction
    title="Poznaj nasze produkty"
    href="/produkty"
    label="Zobacz produkty"
  >
    <p>Poznaj katalog miodów, produktów pszczelich i ziołomiodów.</p>
  </CallToAction>
</>
