---
import AssetImage from "../ui/AssetImage.astro";
import CallToAction from "../ui/CallToAction.astro";
import FeatureTile from "../ui/FeatureTile.astro";
import PageHero from "../ui/PageHero.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ValuesSection from "./ValuesSection.astro";
---

<>
  <PageHero eyebrow="O pasiece" title="Blisko pszczół, blisko natury">
    <p>
      Poznaj podejście, w którym uważna obserwacja natury spotyka się z
      pszczelarskim rzemiosłem.
    </p>
  </PageHero>

  <section class="about-story section">
    <div class="container about-story__inner">
      <div class="about-story__copy">
        <SectionHeading
          eyebrow="Nasze podejście"
          title="Rzemiosło zaczyna się od uważności"
        />
        <div class="prose">
          <p>
            Pasieka to codzienna obecność przy pszczołach i szacunek do ich
            naturalnego rytmu. Obserwujemy zmiany pór roku, kwitnienie roślin i
            to, co dzieje się wokół uli.
          </p>
          <p>
            W pracy liczą się cierpliwość, prostota i gotowość do uczenia się.
            To z tych małych, powtarzalnych czynności wyrasta pszczelarskie
            rzemiosło.
          </p>
        </div>
      </div>
      <figure class="about-story__photo">
        <button
          class="image-zoom-trigger"
          type="button"
          data-lightbox-src="/assets/beekeeper.jpg"
          data-lightbox-alt="Pszczelarz przy ulach z ramką pszczelą w dłoniach"
          data-lightbox-group="about-gallery"
          aria-haspopup="dialog"
          aria-label="Powiększ zdjęcie: Pszczelarz przy ulach z ramką pszczelą w dłoniach"
        >
          <AssetImage
            src="/assets/beekeeper.jpg"
            sizes="(max-width: 899px) 92vw, 46vw"
            loading="lazy"
            alt="Pszczelarz przy ulach z ramką pszczelą w dłoniach"
          />
          <span class="image-zoom-trigger__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="5.5" />
              <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5" />
            </svg>
          </span>
        </button>
        <figcaption>Uważność w każdej porze roku</figcaption>
      </figure>
    </div>
  </section>

  <section class="photo-story section--sm" aria-labelledby="photo-story-title">
    <div class="container">
      <div class="photo-story__heading">
        <p class="eyebrow">Codzienność pasieki</p>
        <h2 id="photo-story-title">Natura w zbliżeniu</h2>
      </div>
      <div class="photo-story__grid">
        <figure class="photo-story__bee">
          <button
            class="image-zoom-trigger"
            type="button"
            data-lightbox-src="/assets/gallery-bee.jpg"
            data-lightbox-alt="Pszczoła zbierająca nektar z kwiatu"
            data-lightbox-group="about-gallery"
            aria-haspopup="dialog"
            aria-label="Powiększ zdjęcie: Pszczoła zbierająca nektar z kwiatu"
          >
            <AssetImage
              src="/assets/gallery-bee.jpg"
              sizes="(max-width: 639px) 92vw, 28vw"
              loading="lazy"
              alt="Pszczoła zbierająca nektar z kwiatu"
            />
            <span class="image-zoom-trigger__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              >
                <circle cx="10.5" cy="10.5" r="5.5" />
                <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5" />
              </svg>
            </span>
          </button>
        </figure>
        <figure class="photo-story__honey">
          <button
            class="image-zoom-trigger"
            type="button"
            data-lightbox-src="/assets/gallery-honey.jpg"
            data-lightbox-alt="Złocisty miód spływający do słoika"
            data-lightbox-group="about-gallery"
            aria-haspopup="dialog"
            aria-label="Powiększ zdjęcie: Złocisty miód spływający do słoika"
          >
            <AssetImage
              src="/assets/gallery-honey.jpg"
              sizes="(max-width: 639px) 92vw, 48vw"
              loading="lazy"
              alt="Złocisty miód spływający do słoika"
            />
            <span class="image-zoom-trigger__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              >
                <circle cx="10.5" cy="10.5" r="5.5" />
                <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5" />
              </svg>
            </span>
          </button>
        </figure>
        <figure class="photo-story__comb">
          <button
            class="image-zoom-trigger"
            type="button"
            data-lightbox-src="/assets/gallery-comb.jpg"
            data-lightbox-alt="Pszczoły pracujące na plastrze miodu"
            data-lightbox-group="about-gallery"
            aria-haspopup="dialog"
            aria-label="Powiększ zdjęcie: Pszczoły pracujące na plastrze miodu"
          >
            <AssetImage
              src="/assets/gallery-comb.jpg"
              sizes="(max-width: 639px) 92vw, 30vw"
              loading="lazy"
              alt="Pszczoły pracujące na plastrze miodu"
            />
            <span class="image-zoom-trigger__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              >
                <circle cx="10.5" cy="10.5" r="5.5" />
                <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5" />
              </svg>
            </span>
          </button>
        </figure>
        <figure class="photo-story__apiary">
          <button
            class="image-zoom-trigger"
            type="button"
            data-lightbox-src="/assets/apiary.jpg"
            data-lightbox-alt="Ule na łące z górami i lasem w tle"
            data-lightbox-group="about-gallery"
            aria-haspopup="dialog"
            aria-label="Powiększ zdjęcie: Ule na łące z górami i lasem w tle"
          >
            <AssetImage
              src="/assets/apiary.jpg"
              sizes="(max-width: 639px) 92vw, 70vw"
              loading="lazy"
              alt="Ule na łące z górami i lasem w tle"
            />
            <span class="image-zoom-trigger__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              >
                <circle cx="10.5" cy="10.5" r="5.5" />
                <path d="m15 15 4.5 4.5M10.5 8v5M8 10.5h5" />
              </svg>
            </span>
          </button>
        </figure>
      </div>
    </div>
  </section>

  <section class="bees-focus section">
    <div class="container">
      <div class="bees-focus__heading">
        <SectionHeading
          eyebrow="U podstaw"
          title="Pszczoły w centrum naszej pracy"
        />
        <p>
          Każda decyzja w pasiece zaczyna się od troski o pszczelą rodzinę i
          środowisko, w którym żyje.
        </p>
      </div>
      <div class="feature-grid">
        <FeatureTile
          index={0}
          icon="heart"
          title="Szacunek do pszczół"
          description="Spokój i obserwacja pomagają dostrzegać potrzeby pszczelej rodziny."
        />
        <FeatureTile
          index={1}
          icon="leaf"
          title="Różnorodność pożytków"
          description="Szukamy miejsc, w których natura daje pszczołom różne źródła nektaru i pyłku."
        />
        <FeatureTile
          index={2}
          icon="honey-jar"
          title="Sezonowe rzemiosło"
          description="Rytm prac wyznaczają pory roku oraz to, co w danym czasie dzieje się w ulu."
        />
      </div>
    </div>
  </section>

  <section class="nature-rhythm">
    <div class="nature-rhythm__image">
      <AssetImage
        src="/assets/apiary.jpg"
        sizes="(max-width: 899px) 100vw, 58vw"
        loading="lazy"
        alt="Wędrowna pasieka wśród łąk i gór"
      />
    </div>
    <div class="nature-rhythm__copy">
      <p class="eyebrow eyebrow--line">Wędrowna pasieka</p>
      <h2>W rytmie natury</h2>
      <span class="accent-line" aria-hidden="true"></span>
      <p>
        Wędrowna pasieka podąża za sezonem i różnorodnością pożytków. Rytm
        kwitnienia wskazuje kolejne miejsca, a każda zmiana krajobrazu
        przypomina, jak mocno miód jest związany z naturą.
      </p>
    </div>
  </section>

  <section class="about-quote section">
    <div class="container about-quote__inner">
      <p class="eyebrow">Z pasieki</p>
      <blockquote>„Pszczoły uczą pokory do natury.”</blockquote>
    </div>
  </section>

  <ValuesSection />

  <CallToAction
    title="Poznaj nasze produkty"
    href="/produkty"
    label="Zobacz produkty"
  >
    <p>
      Zobacz produkty dostępne w naszej ofercie i poznaj ich naturalny
      charakter.
    </p>
  </CallToAction>
</>

<style>
  .about-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: var(--space-grid);
  }
  .about-story {
    background: var(--color-background);
  }
  .about-story__copy .prose {
    margin-top: var(--space-3);
  }
  .about-story__photo {
    position: relative;
    min-height: 540px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-image);
  }
  .about-story__photo :global(img) {
    width: 100%;
    height: 540px;
    object-fit: cover;
    object-position: center;
  }
  .image-zoom-trigger {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .image-zoom-trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-zoom-trigger__icon {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    color: var(--color-white);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .image-zoom-trigger__icon svg {
    width: 32px;
    height: 32px;
  }
  .image-zoom-trigger:hover .image-zoom-trigger__icon,
  .image-zoom-trigger:focus-visible .image-zoom-trigger__icon {
    opacity: 1;
  }
  .about-story__photo::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--color-dark-60), transparent 38%);
    content: "";
    pointer-events: none;
  }
  .about-story__photo figcaption {
    position: absolute;
    z-index: 1;
    right: var(--space-3);
    bottom: var(--space-3);
    padding-right: var(--space-2);
    border-right: 2px solid var(--color-primary);
    color: var(--color-white);
    font: italic 500 var(--text-card-title)/1.1 var(--font-heading);
    text-align: right;
  }
  .photo-story {
    padding-bottom: var(--space-section);
    background: var(--color-soft);
  }
  .photo-story__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .photo-story__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 230px 310px;
    gap: var(--space-2);
  }
  .photo-story figure {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  .photo-story figure:hover {
    box-shadow: var(--shadow-subtle);
    transform: translateY(-2px);
  }
  .photo-story :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-story__bee {
    grid-column: 1 / 4;
    grid-row: 1 / 3;
  }
  .photo-story__honey {
    grid-column: 4 / 9;
    grid-row: 1;
  }
  .photo-story__comb {
    grid-column: 9 / 13;
    grid-row: 1;
  }
  .photo-story__apiary {
    grid-column: 4 / 13;
    grid-row: 2;
  }
  .bees-focus {
    background: var(--color-background);
  }
  .bees-focus__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-grid);
    margin-bottom: var(--space-4);
  }
  .bees-focus__heading > p {
    max-width: 42ch;
    color: var(--color-muted);
  }
  .nature-rhythm {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    min-height: 560px;
    background: var(--color-dark);
    color: var(--color-white);
  }
  .nature-rhythm__image {
    position: relative;
    min-height: 100%;
    overflow: hidden;
  }
  .nature-rhythm__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }
  .nature-rhythm__image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 30%, var(--color-dark) 100%);
    content: "";
    pointer-events: none;
  }
  .nature-rhythm__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-section-sm) var(--page-inset) var(--space-section-sm)
      var(--space-grid);
  }
  .nature-rhythm__copy h2 {
    max-width: 12ch;
    font-size: var(--text-section-title);
  }
  .nature-rhythm__copy > p:last-child {
    max-width: 42ch;
    color: var(--color-on-dark);
  }
  .about-quote {
    background: var(--color-soft);
  }
  .about-quote__inner {
    max-width: 900px;
    text-align: center;
  }
  .about-quote .eyebrow {
    color: var(--color-muted);
  }
  .about-quote blockquote {
    margin-top: var(--space-3);
    font: italic 500 var(--text-display)/1.05 var(--font-heading);
    letter-spacing: -0.03em;
  }
  @media (max-width: 899px) {
    .about-story__inner,
    .nature-rhythm {
      grid-template-columns: 1fr;
    }
    .about-story__photo,
    .about-story__photo :global(img),
    .about-story__photo .image-zoom-trigger {
      min-height: 420px;
      height: 420px;
    }
    .nature-rhythm__image {
      min-height: 380px;
    }
    .nature-rhythm__image::after {
      background: linear-gradient(0deg, var(--color-dark), transparent 52%);
    }
    .nature-rhythm__copy {
      padding: var(--space-section-sm) var(--gutter);
    }
  }
  @media (max-width: 639px) {
    .photo-story__heading,
    .bees-focus__heading {
      display: block;
    }
    .photo-story__heading h2,
    .bees-focus__heading > p {
      margin-top: var(--space-2);
    }
    .photo-story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 220px 170px 250px;
      gap: var(--space-1);
    }
    .photo-story__bee {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .photo-story__honey {
      grid-column: 2;
      grid-row: 1;
    }
    .photo-story__comb {
      grid-column: 2;
      grid-row: 2;
    }
    .photo-story__apiary {
      grid-column: 1 / 3;
      grid-row: 3;
    }
    .about-story__photo,
    .about-story__photo :global(img),
    .about-story__photo .image-zoom-trigger {
      min-height: 340px;
      height: 340px;
    }
    .nature-rhythm__image {
      min-height: 300px;
    }
  }
</style>
