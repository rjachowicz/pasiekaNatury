---
import BrandLockup from "../ui/BrandLockup.astro";
import { navigation } from "../../data/site";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="header" data-site-header>
  <div class="container header__inner">
    <BrandLockup />
    <button
      class="header__toggle"
      data-navigation-toggle
      type="button"
      aria-controls="main-navigation"
      aria-expanded="false"
      aria-label="Otwórz menu"
      hidden
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav
      id="main-navigation"
      class="nav"
      data-navigation
      aria-label="Nawigacja główna"
    >
      {navigation.map(({ href, label }) => (
        <a
          class="nav__link"
          href={href}
          aria-current={pathname === href ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import "../../scripts/mobileNavigation";
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-dark);
    color: var(--color-white);
    box-shadow: 0 1px 0 var(--color-white-9);
  }

  .header__inner {
    display: flex;
    min-height: 110px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__inner :global(.brand-lockup) {
    position: relative;
    z-index: 2;
    flex: 0 0 290px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, var(--space-grid));
  }

  .nav__link {
    position: relative;
    display: flex;
    min-height: 48px;
    align-items: center;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current] {
    color: var(--color-primary);
  }

  .nav__link::after {
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 24px;
    height: 1px;
    background: var(--color-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .header__toggle {
    display: none;
  }

  @media (max-width: 899px) {
    .header__inner {
      min-height: 82px;
      gap: 0;
    }

    .header__inner :global(.brand-lockup) {
      flex: 1 1 auto;
    }

    .nav {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: var(--space-3);
    }

    .nav__link {
      min-height: 56px;
      border-bottom: 1px solid var(--color-white-8);
    }

    .nav__link::after {
      bottom: 10px;
    }

    .header--enhanced .nav {
      position: absolute;
      top: 100%;
      left: 0;
      max-height: calc(100dvh - 82px);
      overflow-y: auto;
      padding: var(--space-3) var(--gutter);
      background: var(--color-dark);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity var(--transition),
        transform var(--transition),
        visibility var(--transition);
      box-shadow: var(--shadow-subtle);
    }

    .header--open .nav {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .header__toggle:not([hidden]) {
      display: flex;
      width: 48px;
      height: 48px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px;
      border: 0;
      background: transparent;
      color: var(--color-white);
      cursor: pointer;
    }

    .header__toggle:hover {
      color: var(--color-primary);
    }

    .header__toggle:focus-visible {
      color: var(--color-primary);
      outline-color: var(--color-primary);
      outline-offset: -4px;
    }

    .header__toggle span {
      width: 26px;
      height: 2px;
      background: currentColor;
      transition:
        transform var(--transition),
        opacity var(--transition);
    }

    .header--open .header__toggle span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .header--open .header__toggle span:nth-child(2) {
      opacity: 0;
    }

    .header--open .header__toggle span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>
