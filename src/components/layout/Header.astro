---
import AssetImage from "../ui/AssetImage.astro";
import { navigation } from "../../data/site";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="header">
  <div class="container header__inner">
    <a
      class="header__logo"
      href="/"
      aria-label="Pasieka 100% Natury — strona główna"
    >
      <AssetImage
        src="/assets/logo.png"
        loading="eager"
        alt="Pasieka 100% Natury — Wędrowna"
      />
    </a>
    <button
      class="header__toggle"
      type="button"
      aria-controls="main-navigation"
      aria-expanded="false"
      aria-label="Otwórz menu"
      hidden
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="main-navigation" class="nav" aria-label="Nawigacja główna">
      {navigation.map(({ href, label }) => (
        <a
          class="nav__link"
          href={href}
          aria-current={pathname === href ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".header");
  const toggle = header?.querySelector<HTMLButtonElement>(".header__toggle");
  const nav = header?.querySelector<HTMLElement>(".nav");
  if (header && toggle && nav) {
    header.classList.add("header--enhanced");
    toggle.hidden = false;
    const closeMenu = (restoreFocus = false) => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Otwórz menu");
      header.classList.remove("header--open");
      document.body.classList.remove("is-scroll-locked");
      if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Zamknij menu" : "Otwórz menu");
      header.classList.toggle("header--open", open);
      document.body.classList.toggle("is-scroll-locked", open);
    });
    nav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a"))
        closeMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      )
        closeMenu(true);
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target))
        closeMenu();
    });
    header.addEventListener("focusout", (event) => {
      if (
        event.relatedTarget instanceof Node &&
        !header.contains(event.relatedTarget)
      )
        closeMenu();
    });
    matchMedia("(min-width: 900px)").addEventListener("change", () =>
      closeMenu(),
    );
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-dark);
    color: var(--color-white);
    box-shadow: 0 1px 0 #ffffff16;
  }

  .header__inner {
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__logo {
    position: relative;
    z-index: 2;
    flex: 0 0 108px;
    align-self: stretch;
  }

  .header__logo img {
    position: absolute;
    top: 8px;
    width: 108px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-grid);
  }

  .nav__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav__link:hover,
  .nav__link[aria-current] {
    color: var(--color-primary);
  }

  .nav__link::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 24px;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav__link:hover::after,
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .header__toggle {
    display: none;
  }

  @media (max-width: 899px) {
    .header__inner {
      flex-wrap: wrap;
      gap: 0;
    }

    .header__logo {
      flex-basis: 84px;
      min-height: 76px;
    }

    .header__logo img {
      top: 5px;
      width: 84px;
    }

    .nav {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: var(--space-3);
    }

    .nav__link {
      min-height: 56px;
      border-bottom: 1px solid #ffffff14;
    }

    .nav__link::after {
      bottom: 10px;
    }

    .header--enhanced .nav {
      position: absolute;
      top: 100%;
      left: 0;
      max-height: calc(100dvh - 76px);
      overflow-y: auto;
      padding: var(--space-3) var(--gutter);
      background: var(--color-dark);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity var(--transition),
        transform var(--transition),
        visibility var(--transition);
      box-shadow: var(--shadow-subtle);
    }

    .header--open .nav {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .header__toggle:not([hidden]) {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 6px;
      width: 48px;
      height: 48px;
      padding: 10px;
      border: 0;
      background: transparent;
      color: var(--color-white);
      cursor: pointer;
    }

    .header__toggle:hover {
      color: var(--color-primary);
    }

    .header__toggle span {
      width: 26px;
      height: 2px;
      background: currentColor;
      transition:
        transform var(--transition),
        opacity var(--transition);
    }

    .header--open .header__toggle span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .header--open .header__toggle span:nth-child(2) {
      opacity: 0;
    }

    .header--open .header__toggle span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>
