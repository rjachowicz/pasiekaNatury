---
import BrandLockup from "../ui/BrandLockup.astro";
import AssetImage from "../ui/AssetImage.astro";
import { contact, navigation } from "../../data/site";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const year = new Date().getFullYear();
---

<footer class="footer">
  <AssetImage
    class="footer__mountains"
    widths={[320, 640]}
    sizes="(max-width: 639px) 100vw, 45vw"
    src="/assets/mountains.png"
    loading="lazy"
    alt=""
    aria-hidden="true"
  />
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <BrandLockup variant="footer" loading="lazy" />
        <p>
          Blisko pszczół. Blisko natury.
          <br />
          Naturalne miody z wędrownej pasieki.
        </p>
      </div>
      <div>
        <h2 class="eyebrow">Poznaj pasiekę</h2>
        <nav class="footer__nav" aria-label="Nawigacja w stopce">
          {navigation.map(({ href, label }) => (
            <a
              href={href}
              aria-current={pathname === href ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
      <div>
        <h2 class="eyebrow">Porozmawiajmy</h2>
        <address class="footer__contact">
          {contact.phones.map(({ display, href }) => (
            <a href={href}>{display}</a>
          ))}
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <span>{contact.address}</span>
          {contact.facebookUrl && (
            <a
              href={contact.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook <span aria-hidden="true">↗</span>
            </a>
          )}
          {contact.instagramUrl && (
            <a
              href={contact.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram <span aria-hidden="true">↗</span>
            </a>
          )}
        </address>
        <p class="footer__note">Przed wizytą umów dogodny termin.</p>
      </div>
    </div>
    <div class="footer__bottom">
      <div class="footer__privacy-links">
        <a href="/polityka-prywatnosci">Polityka prywatności</a>
        <button class="footer__privacy" type="button" data-privacy-settings>
          Ustawienia prywatności
        </button>
      </div>
      <p>© {year} Pasieka 100% Natury. Wszelkie prawa zastrzeżone.</p>
      <span>W rytmie natury</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    padding-top: 72px;
    background: var(--color-dark);
    color: var(--color-white);
  }

  .footer__mountains {
    position: absolute;
    z-index: -1;
    right: 0;
    bottom: 0;
    width: min(45%, 560px);
    height: 100%;
    object-fit: contain;
    object-position: right bottom;
    opacity: 0.07;
    filter: grayscale(1) invert(1);
    pointer-events: none;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: var(--space-grid);
    padding-bottom: var(--space-section-sm);
  }

  .footer__grid > * {
    min-width: 0;
  }

  .footer__brand :global(.brand-lockup) {
    margin-bottom: var(--space-3);
  }

  .footer__brand p {
    color: var(--color-on-dark);
    font-size: var(--text-small);
    line-height: 1.7;
  }

  .eyebrow {
    margin-block: var(--space-2) var(--space-3);
    color: var(--color-primary);
  }

  .footer__nav,
  .footer__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--text-small);
    font-style: normal;
  }

  .footer__nav a,
  .footer__contact a,
  .footer__contact > span {
    display: flex;
    min-height: 44px;
    max-width: 100%;
    align-items: center;
    overflow-wrap: anywhere;
  }

  .footer a:hover,
  .footer a[aria-current] {
    color: var(--color-primary);
  }

  .footer__note {
    margin-top: var(--space-2);
    color: var(--color-on-dark);
    font-size: var(--text-eyebrow);
  }

  .footer__bottom {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 28px;
    color: var(--color-on-dark);
    font-size: var(--text-eyebrow);
  }

  .footer__bottom::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--color-white-19),
      var(--color-primary-25) 50%,
      var(--color-white-6)
    );
    content: "";
  }

  .footer__bottom > span {
    flex-shrink: 0;
  }

  .footer__privacy {
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 4px;
  }

  .footer__privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer__privacy-links > a {
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 4px;
  }

  .footer__privacy:hover {
    color: var(--color-primary);
  }

  @media (max-width: 899px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    .footer__brand {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .footer__brand :global(.brand-lockup) {
      flex: 0 0 auto;
      margin: 0;
    }
  }

  @media (max-width: 639px) {
    .footer {
      padding-top: 48px;
    }

    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__brand {
      display: block;
    }

    .footer__brand :global(.brand-lockup) {
      margin-bottom: var(--space-3);
    }

    .eyebrow {
      margin-top: 0;
      margin-bottom: var(--space-2);
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-1);
    }

    .footer__mountains {
      width: 100%;
      max-height: 340px;
    }
  }
</style>
