---
import CallToAction from "../ui/CallToAction.astro";
import PageHero from "../ui/PageHero.astro";
import ContactDetailsSection from "./sections/ContactDetailsSection.astro";
import ContactMapSection from "./sections/ContactMapSection.astro";
import SocialMediaSection from "./sections/SocialMediaSection.astro";
---

<>
  <PageHero
    eyebrow="Kontakt"
    title="Porozmawiajmy o produktach pasieki"
    image="/assets/bees.jpg"
    imageAlt="Wędrowna pasieka wśród łąk i gór"
  >
    <p>
      Zapytaj o aktualną dostępność, gramatury i szczegóły. Jesteśmy do
      dyspozycji przez telefon, e-mail i media społecznościowe.
    </p>
  </PageHero>

  <div class="contact-page">
    <ContactDetailsSection />
    <SocialMediaSection />
    <ContactMapSection />
  </div>

  <CallToAction
    title="Poznaj nasze produkty"
    href="/produkty"
    label="Zobacz produkty"
  >
    <p>
      Sprawdź produkty prezentowane w naszej ofercie, a o szczegóły zapytaj nas
      bezpośrednio.
    </p>
  </CallToAction>
</>

<style>
  .contact-page {
    background: var(--color-background);
  }
</style>
