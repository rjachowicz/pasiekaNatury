---
import CallToAction from "../ui/CallToAction.astro";
import ContactDetails from "../ui/ContactDetails.astro";
import GoogleMap from "../ui/GoogleMap.astro";
import Icon from "../ui/Icon.astro";
import PageHero from "../ui/PageHero.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { products } from "../../data/products";
import { contact } from "../../data/site";

const productOptions = products.map(({ id, name }) => ({ id, name }));
---

<>
  <PageHero eyebrow="Kontakt" title="Porozmawiajmy o miodzie">
    <p>
      Zapytaj o aktualną dostępność, gramatury i szczegóły. Jesteśmy do
      dyspozycji przez telefon, e-mail i media społecznościowe.
    </p>
  </PageHero>

  <div class="contact-page">
    <section class="contact-overview section">
      <div class="container">
        <div
          class="contextual-product"
          hidden
          data-products={JSON.stringify(productOptions)}
        >
          <p class="eyebrow">Pytasz o</p>
          <p class="contextual-product__name" data-product-name></p>
          <p>
            Sprawdzimy aktualną dostępność, gramatury i szczegóły wybranego
            miodu.
          </p>
        </div>

        <div class="contact-overview__heading">
          <div>
            <p class="eyebrow eyebrow--line">Bądźmy w kontakcie</p>
            <h2>Wybierz najwygodniejszą formę</h2>
          </div>
          <p>
            Przed przyjazdem do pasieki zadzwoń lub napisz, aby wspólnie ustalić
            dogodny termin.
          </p>
        </div>

        <div class="contact-overview__grid">
          <div class="contact-overview__details">
            <ContactDetails variant="tiles" />
          </div>
          <aside class="contact-overview__visit">
            <span class="contact-overview__icon">
              <Icon name="honey-jar" size={26} />
            </span>
            <p class="eyebrow">Wizyta w pasiece</p>
            <h3>Jasienna, blisko natury</h3>
            <p>
              Chętnie opowiemy o dostępnych miodach i wskażemy drogę. Każdą
              wizytę najlepiej umówić wcześniej.
            </p>
            <a
              href={contact.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Wyznacz trasę <Icon name="arrow-up-right" size={17} />
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section class="social-section section--sm">
      <div class="container social-section__inner">
        <div class="social-section__copy">
          <SectionHeading
            eyebrow="Na bieżąco"
            title="Znajdź nas w mediach społecznościowych"
          />
          <p>
            Zajrzyj na nasze profile, aby zobaczyć codzienność pasieki, pszczoły
            przy pracy i aktualne informacje.
          </p>
        </div>
        <div class="social-links">
          <a
            href={contact.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="social-links__icon">
              <Icon name="facebook" size={24} />
            </span>
            <span>
              <strong>Facebook</strong>
              <small>Odwiedź profil pasieki</small>
            </span>
            <Icon name="arrow-up-right" size={18} />
          </a>
          <a
            href={contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="social-links__icon">
              <Icon name="instagram" size={24} />
            </span>
            <span>
              <strong>Instagram</strong>
              <small>@pasieka_100_natura</small>
            </span>
            <Icon name="arrow-up-right" size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="map-section section">
      <div class="container">
        <div class="map-section__heading">
          <SectionHeading eyebrow="Dojazd" title="Odwiedź pasiekę" />
          <address>
            <span>Jasienna 171</span>
            <span>33-322 Korzenna, Polska</span>
          </address>
        </div>
        <GoogleMap />
      </div>
    </section>
  </div>

  <CallToAction
    title="Poznaj nasze miody"
    href="/produkty"
    label="Zobacz produkty"
  >
    <p>
      Sprawdź smaki dostępne w naszej ofercie, a o szczegóły zapytaj nas
      bezpośrednio.
    </p>
  </CallToAction>
</>

<script>
  const contextualBox = document.querySelector<HTMLElement>(
    ".contextual-product",
  );
  const productName = document.querySelector<HTMLElement>(
    "[data-product-name]",
  );
  const productId = new URLSearchParams(window.location.search).get("produkt");
  const productOptions = JSON.parse(
    contextualBox?.dataset.products ?? "[]",
  ) as Array<{
    id: string;
    name: string;
  }>;
  const product = productOptions.find(({ id }) => id === productId);

  if (contextualBox && productName && product) {
    productName.textContent = product.name;
    contextualBox.hidden = false;
  }
</script>

<style>
  .contact-page {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 10% 22%,
        var(--color-primary-25),
        transparent 20rem
      ),
      linear-gradient(
        180deg,
        var(--color-background),
        var(--color-warm) 52%,
        var(--color-background)
      );
  }

  .contact-page::before,
  .contact-page::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .contact-page::before {
    top: 3%;
    right: -170px;
    width: 520px;
    height: 580px;
    background: url("/assets/honeycomb.png") center / contain no-repeat;
    opacity: 0.055;
    transform: rotate(-12deg);
  }

  .contact-page::after {
    right: 12%;
    bottom: 3%;
    width: 360px;
    height: 360px;
    border: 1px solid var(--color-primary-25);
    border-radius: 50%;
    box-shadow:
      0 0 0 56px var(--color-primary-25),
      0 0 0 112px #f9bd0012;
    opacity: 0.42;
  }

  .contact-overview__heading,
  .map-section__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 0.64fr);
    align-items: end;
    gap: var(--space-grid);
    margin-bottom: var(--space-4);
  }

  .contact-overview__heading h2 {
    max-width: 16ch;
  }

  .contact-overview__heading > p {
    max-width: 42ch;
    justify-self: end;
    color: var(--color-muted);
  }

  .contextual-product {
    max-width: 740px;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
    border: var(--border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-soft-90);
    box-shadow: var(--shadow-subtle);
  }

  .contextual-product .eyebrow {
    margin-bottom: 4px;
  }

  .contextual-product__name {
    font: 600 var(--text-card-title)/1.1 var(--font-heading);
  }

  .contextual-product p:last-child {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .contact-overview__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(270px, 0.75fr);
    gap: var(--space-3);
    align-items: stretch;
  }

  .contact-overview__visit {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid #d9c789;
    border-radius: var(--radius-card);
    background: linear-gradient(145deg, #fffaf0, #f7ecd0), var(--color-soft);
    box-shadow: var(--shadow-subtle);
  }

  .contact-overview__icon,
  .social-links__icon {
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .contact-overview__icon {
    width: 54px;
    height: 54px;
    margin-bottom: auto;
  }

  .contact-overview__visit .eyebrow {
    margin: var(--space-4) 0 var(--space-1);
  }

  .contact-overview__visit h3 {
    font-size: clamp(1.75rem, 2vw, 2.2rem);
  }

  .contact-overview__visit > p:last-of-type {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .contact-overview__visit a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-4);
    color: var(--color-dark);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-decoration-color: var(--color-primary-hover);
    text-underline-offset: 6px;
    text-transform: uppercase;
  }

  .social-section {
    position: relative;
    border-block: var(--border);
    background: var(--color-soft-87);
  }

  .social-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: var(--space-grid);
    align-items: center;
  }

  .social-section__copy > p {
    max-width: 45ch;
    margin-top: var(--space-3);
    color: var(--color-muted);
  }

  .social-links {
    display: grid;
    gap: var(--space-2);
  }

  .social-links a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 24px;
    align-items: center;
    gap: var(--space-2);
    min-height: 92px;
    padding: var(--space-2) var(--space-3);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-subtle);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-image);
    transform: translateY(-2px);
  }

  .social-links__icon {
    width: 48px;
    height: 48px;
  }

  .social-links > a > :global(svg:last-child) {
    justify-self: end;
    color: var(--color-muted);
  }

  .social-links strong,
  .social-links small {
    display: block;
  }

  .social-links strong {
    font: 600 var(--text-card-title)/1.1 var(--font-heading);
  }

  .social-links small {
    margin-top: 4px;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .map-section {
    position: relative;
  }

  .map-section__heading address {
    display: grid;
    justify-self: end;
    padding-bottom: 5px;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-style: normal;
    text-align: right;
  }

  @media (max-width: 899px) {
    .contact-overview__heading,
    .map-section__heading,
    .contact-overview__grid,
    .social-section__inner {
      grid-template-columns: 1fr;
    }

    .contact-overview__heading > p,
    .map-section__heading address {
      justify-self: start;
      text-align: left;
    }

    .contact-overview__visit {
      min-height: 290px;
    }
  }

  @media (max-width: 639px) {
    .contact-page::before {
      right: -260px;
      width: 420px;
      opacity: 0.04;
    }

    .contact-page::after {
      right: -80px;
      bottom: 5%;
      transform: scale(0.7);
    }

    .contextual-product {
      padding: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .contact-overview__visit {
      min-height: 0;
    }
  }
</style>
