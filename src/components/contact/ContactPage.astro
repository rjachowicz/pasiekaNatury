---
import CallToAction from "../ui/CallToAction.astro";
import PageHero from "../ui/PageHero.astro";
import ContactDetailsSection from "./sections/ContactDetailsSection.astro";
import ContactMapSection from "./sections/ContactMapSection.astro";
import SocialMediaSection from "./sections/SocialMediaSection.astro";
---

<>
  <PageHero
    eyebrow="Kontakt"
    title="Kontakt z Pasieką 100% Natury"
    image="/assets/bees.png"
    imageAlt="Wędrowna pasieka wśród łąk i gór"
  >
    <p>
      Zadzwoń pod jeden z dwóch numerów, napisz e-mail lub umów wizytę w
      Jasiennej. Dostępność produktów potwierdzamy bezpośrednio.
    </p>
  </PageHero>

  <div class="contact-page">
    <ContactDetailsSection />
    <SocialMediaSection />
    <ContactMapSection />
  </div>

  <CallToAction
    title="Poznaj nasze produkty"
    href="/produkty"
    label="Zobacz produkty"
  >
    <p>
      Zobacz uporządkowany katalog i wybierz pozycję, o którą chcesz zapytać.
    </p>
  </CallToAction>
</>

<style>
  .contact-page {
    background: var(--color-background);
  }
</style>
