---
import CallToAction from "../ui/CallToAction.astro";
import ContactDetails from "../ui/ContactDetails.astro";
import GoogleMap from "../ui/GoogleMap.astro";
import Icon from "../ui/Icon.astro";
import PageHero from "../ui/PageHero.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { products } from "../../data/products";
import { contact } from "../../data/site";

const productOptions = products.map(({ id, name }) => ({ id, name }));
---

<>
  <PageHero eyebrow="Kontakt" title="Porozmawiajmy o miodzie">
    <p>
      Zapytaj o aktualną dostępność, gramatury i szczegóły. Jesteśmy do
      dyspozycji przez telefon i e-mail.
    </p>
  </PageHero>

  <section class="contact-intro section--sm">
    <div class="container contact-intro__inner">
      <p class="eyebrow eyebrow--line">Bądźmy w kontakcie</p>
      <p>
        Wybierz wygodną formę kontaktu. Przed przyjazdem do pasieki skontaktuj
        się z nami, aby ustalić termin.
      </p>
    </div>
  </section>

  <section class="contact-details-section section">
    <div class="container">
      <div
        class="contextual-product"
        hidden
        data-products={JSON.stringify(productOptions)}
      >
        <p class="eyebrow">Pytasz o</p>
        <p class="contextual-product__name" data-product-name></p>
        <p>
          Skontaktuj się z nami, aby sprawdzić aktualną dostępność, gramatury i
          szczegóły.
        </p>
      </div>
      <div class="contact-details-section__heading">
        <SectionHeading eyebrow="Dane kontaktowe" title="Napisz lub zadzwoń" />
      </div>
      <ContactDetails variant="tiles" />
    </div>
  </section>

  <section class="social-section section--sm">
    <div class="container social-section__inner">
      <div>
        <SectionHeading
          eyebrow="Na bieżąco"
          title="Znajdź nas w mediach społecznościowych"
        />
      </div>
      <div class="social-links">
        <a href={contact.facebookUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="facebook" size={28} />
          <span>
            <strong>Facebook</strong>
            <small>Odwiedź profil pasieki</small>
          </span>
          <Icon name="arrow-up-right" size={18} />
        </a>
        <a
          href={contact.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="instagram" size={28} />
          <span>
            <strong>Instagram</strong>
            <small>@pasieka_100_natura</small>
          </span>
          <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <section class="map-section section">
    <div class="container">
      <div class="map-section__heading">
        <SectionHeading eyebrow="Dojazd" title="Odwiedź pasiekę" />
        <p>Jasienna 171, 33-322 Korzenna, Polska</p>
      </div>
      <GoogleMap />
    </div>
  </section>

  <section class="visit-note section--sm">
    <div class="container">
      <div class="visit-note__inner">
        <Icon name="phone" size={28} />
        <p>Przed przyjazdem skontaktuj się z nami</p>
        <a href={contact.phoneHref}>{contact.phone}</a>
      </div>
    </div>
  </section>

  <CallToAction
    title="Poznaj nasze miody"
    href="/produkty"
    label="Zobacz produkty"
  >
    <p>
      Sprawdź smaki, które są dostępne w naszej ofercie, a o szczegóły zapytaj
      nas bezpośrednio.
    </p>
  </CallToAction>
</>

<script>
  const contextualBox = document.querySelector<HTMLElement>(
    ".contextual-product",
  );
  const productName = document.querySelector<HTMLElement>(
    "[data-product-name]",
  );
  const productId = new URLSearchParams(window.location.search).get("produkt");
  const productOptions = JSON.parse(
    contextualBox?.dataset.products ?? "[]",
  ) as Array<{ id: string; name: string }>;
  const product = productOptions.find(({ id }) => id === productId);

  if (contextualBox && productName && product) {
    productName.textContent = product.name;
    contextualBox.hidden = false;
  }
</script>

<style>
  .contact-intro {
    border-bottom: var(--border);
    background: var(--color-soft);
  }
  .contact-intro__inner {
    display: grid;
    grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-grid);
  }
  .contact-intro__inner > p:last-child {
    max-width: 54ch;
    color: var(--color-muted);
  }
  .contextual-product {
    max-width: 720px;
    margin-bottom: var(--space-5);
    padding: var(--space-3);
    border-left: 3px solid var(--color-primary);
    background: var(--color-soft);
  }
  .contextual-product__name {
    margin-top: 4px;
    font: 600 var(--text-card-title)/1.15 var(--font-heading);
  }
  .contextual-product p:last-child {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .contact-details-section__heading {
    margin-bottom: var(--space-4);
  }
  .social-section {
    background: var(--color-soft);
    border-block: var(--border);
  }
  .social-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    gap: var(--space-grid);
    align-items: center;
  }
  .social-links {
    display: grid;
    gap: var(--space-2);
  }
  .social-links a {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 20px;
    align-items: center;
    gap: var(--space-2);
    min-height: 84px;
    padding: var(--space-3);
    border: var(--border);
    background: var(--color-white);
  }
  .social-links a:hover {
    border-color: var(--color-primary);
  }
  .social-links > a > :global(svg:first-child) {
    color: var(--color-primary);
  }
  .social-links > a > :global(svg:last-child) {
    justify-self: end;
  }
  .social-links strong,
  .social-links small {
    display: block;
  }
  .social-links strong {
    font: 600 var(--text-card-title)/1.1 var(--font-heading);
  }
  .social-links small {
    margin-top: 4px;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }
  .map-section__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .map-section__heading > p {
    padding-bottom: 8px;
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .visit-note {
    padding-top: 0;
    padding-bottom: var(--space-section);
  }
  .visit-note__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-block: var(--border);
  }
  .visit-note__inner :global(svg) {
    color: var(--color-primary);
  }
  .visit-note__inner p {
    font: 500 var(--text-card-title)/1.2 var(--font-heading);
  }
  .visit-note__inner a {
    margin-left: auto;
    color: var(--color-muted);
    font-size: var(--text-small);
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 5px;
  }
  @media (max-width: 899px) {
    .contact-intro__inner,
    .social-section__inner {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .map-section__heading {
      display: block;
    }
    .map-section__heading > p {
      margin-top: var(--space-2);
      padding: 0;
    }
  }
  @media (max-width: 639px) {
    .visit-note__inner {
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .visit-note__inner p {
      flex: 1 1 200px;
    }
    .visit-note__inner a {
      width: 100%;
      margin-left: 36px;
    }
  }
</style>
