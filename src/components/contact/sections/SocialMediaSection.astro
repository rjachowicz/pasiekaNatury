---
import Icon from "../../ui/Icon.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
import { contact } from "../../../data/site";
---

<section class="social-section section--sm">
  <div class="container social-section__inner">
    <div class="social-section__copy">
      <SectionHeading
        eyebrow="Na bieżąco"
        title="Znajdź nas w mediach społecznościowych"
      />
      <p>
        Zajrzyj na nasze profile, aby zobaczyć codzienność pasieki, pszczoły
        przy pracy i aktualne informacje.
      </p>
    </div>
    <div class="social-links">
      <a href={contact.facebookUrl} target="_blank" rel="noopener noreferrer">
        <span class="social-links__icon">
          <Icon name="facebook" size={24} />
        </span>
        <span>
          <strong>Facebook</strong>
          <small>Odwiedź profil pasieki</small>
        </span>
        <Icon name="arrow-up-right" size={18} />
      </a>
      <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer">
        <span class="social-links__icon">
          <Icon name="instagram" size={24} />
        </span>
        <span>
          <strong>Instagram</strong>
          <small>@pasieka_100_natura</small>
        </span>
        <Icon name="arrow-up-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .social-section {
    position: relative;
    border-block: var(--border);
    background: var(--color-soft);
  }
  .social-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: var(--space-grid);
    align-items: center;
  }
  .social-section__copy > p {
    max-width: 45ch;
    margin-top: var(--space-3);
    color: var(--color-muted);
  }
  .social-links {
    display: grid;
    gap: var(--space-2);
  }
  .social-links a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 24px;
    align-items: center;
    gap: var(--space-2);
    min-height: 64px;
    min-width: 0;
    padding: var(--space-2) 0;
    border-bottom: var(--border);
    transition:
      border-color var(--transition),
      color var(--transition);
  }
  .social-links a:hover,
  .social-links a:focus-visible {
    color: var(--color-primary);
  }
  .social-links__icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    color: var(--color-primary);
  }
  .social-links a > span:nth-child(2) {
    min-width: 0;
    word-break: normal;
    overflow-wrap: break-word;
  }
  .social-links > a > :global(svg:last-child) {
    justify-self: end;
    color: var(--color-muted);
  }
  .social-links strong,
  .social-links small {
    display: block;
  }
  .social-links strong {
    font: 600 1.35rem / 1.1 var(--font-heading);
  }
  .social-links small {
    margin-top: 4px;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }
  @media (max-width: 899px) {
    .social-section__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
