---
import ValueIcon, { type ValueIconName } from "./ValueIcon.astro";

interface Props {
  title: string;
  description: string;
  icon: ValueIconName;
  index?: number;
}

const { title, description, icon, index } = Astro.props;
---

<article class="feature-tile" data-reveal>
  <div class="feature-tile__top">
    <ValueIcon name={icon} />
    {index !== undefined && (
      <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
    )}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>

<style>
  .feature-tile {
    min-width: 0;
    padding: 28px;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-subtle);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .feature-tile:hover {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-image);
  }

  .feature-tile__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .feature-tile__top :global(.value-icon) {
    width: 70px;
  }

  .feature-tile__top span {
    font-size: var(--text-eyebrow);
    color: var(--color-muted);
  }

  h3 {
    font-size: var(--text-card-title);
  }

  p {
    max-width: 44ch;
    margin-top: 12px;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  @media (max-width: 899px) {
    .feature-tile {
      display: grid;
      grid-template-columns: 70px minmax(0, 1fr);
      column-gap: 20px;
      padding: 24px;
    }

    .feature-tile__top {
      grid-row: span 2;
      margin: 0;
    }

    .feature-tile__top span {
      display: none;
    }

    p {
      margin-top: 8px;
    }
  }
</style>
