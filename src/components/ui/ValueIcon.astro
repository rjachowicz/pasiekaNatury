---
export type ValueIconName = "heart" | "leaf" | "tree" | "honey-jar";

interface Props {
  name: ValueIconName;
  size?: number | string;
  title?: string;
}

const { name, size = 76, title } = Astro.props;
const labelled = Boolean(title);
---

<svg
  class="value-icon"
  viewBox="0 0 100 115.47"
  width={size}
  height="auto"
  role={labelled ? "img" : undefined}
  aria-hidden={labelled ? undefined : "true"}
  aria-label={title}
>
  {title && <title>{title}</title>}
  <polygon
    fill="none"
    stroke="var(--color-primary)"
    stroke-width="1.5"
    stroke-linejoin="round"
    points="50,1 99,29.29 99,86.18 50,114.47 1,86.18 1,29.29"
  />
  <g class="value-icon__glyph" vector-effect="non-scaling-stroke">
    {name === "heart" && (
      <path
        fill="var(--color-primary)"
        stroke="var(--color-dark)"
        d="M50 73S35 64 35 52.7c0-5.1 3.6-8.7 8.4-8.7 3 0 5.5 1.5 6.6 3.8 1.2-2.3 3.7-3.8 6.6-3.8 4.8 0 8.4 3.6 8.4 8.7C65 64 50 73 50 73Z"
      />
    )}
    {name === "leaf" && (
      <>
        <path
          fill="var(--color-primary)"
          stroke="var(--color-dark)"
          d="M67 42c-14.2.5-24 6.2-25.5 15.7-1 6.3 3 10.8 8.8 10.8C60.3 68.5 65.7 57.6 67 42Z"
        />
        <path
          fill="none"
          stroke="var(--color-dark)"
          d="M40 72c6.1-8.4 12.4-14.4 21.3-19.4"
        />
      </>
    )}
    {name === "tree" && (
      <>
        <path
          fill="var(--color-primary)"
          stroke="var(--color-dark)"
          d="m50 39-10.5 12h6.5l-9 11h6.5l-8 10h42l-8-10h6.5l-9-11h6.5L50 39Z"
        />
        <path fill="none" stroke="var(--color-dark)" d="M50 72v8" />
      </>
    )}
    {name === "honey-jar" && (
      <>
        <path
          fill="none"
          stroke="var(--color-dark)"
          d="M38 47h24l-1.7 25a4.5 4.5 0 0 1-4.5 4.2H44.2a4.5 4.5 0 0 1-4.5-4.2L38 47Z"
        />
        <path
          fill="var(--color-primary)"
          stroke="var(--color-dark)"
          d="M41.5 47v-4h17v4M42 58h16v9H42Z"
        />
      </>
    )}
  </g>
</svg>

<style>
  .value-icon {
    display: block;
    overflow: visible;
  }

  .value-icon__glyph {
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
