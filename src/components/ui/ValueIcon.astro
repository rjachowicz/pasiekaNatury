---
export type ValueIconName = "heart" | "leaf" | "tree" | "honey-jar";

interface Props {
  name: ValueIconName;
  size?: number | string;
  title?: string;
}

const { name, size = 76, title } = Astro.props;
const labelled = Boolean(title);
---

<svg
  class="value-icon"
  viewBox="0 0 100 115.47"
  width={size}
  height="auto"
  role={labelled ? "img" : undefined}
  aria-hidden={labelled ? undefined : "true"}
  aria-label={title}
>
  {title && <title>{title}</title>}
  <polygon
    fill="none"
    stroke="var(--color-primary)"
    stroke-width="1.5"
    stroke-linejoin="round"
    points="50,1 99,29.29 99,86.18 50,114.47 1,86.18 1,29.29"
  />
  <g class="value-icon__glyph">
    {name === "heart" && (
      <path d="M50 78S30 65.3 30 51.7C30 43.8 35.2 38 42.4 38c3.4 0 6 1.3 7.6 4.2 1.6-2.9 4.2-4.2 7.6-4.2 7.2 0 12.4 5.8 12.4 13.7C70 65.3 50 78 50 78Z" />
    )}
    {name === "leaf" && (
      <>
        <path d="M69.5 38.5C51 39.4 36.6 47.3 32.5 61c-2.3 7.6 1.3 14.2 8.8 16.2 11.7 3.1 25.4-10.4 28.2-38.7Z" />
        <path d="M30.5 79c10.4-14.4 20-23.5 34.7-31.5" />
      </>
    )}
    {name === "tree" && (
      <>
        <path d="m50 37 13.5 14h-7.2l11.7 14h-7.1l9.1 14H30l9.1-14H32l11.7-14h-7.2L50 37Z" />
        <path d="M50 68v11" />
      </>
    )}
    {name === "honey-jar" && (
      <>
        <path d="M30 45h40l-2.5 28.5A5.5 5.5 0 0 1 62 79H38a5.5 5.5 0 0 1-5.5-5.5L30 45Z" />
        <path d="M34 45v-7h32v7M37 58h26v11H37Z" />
      </>
    )}
  </g>
</svg>

<style>
  .value-icon {
    display: block;
    overflow: visible;
  }

  .value-icon__glyph {
    fill: var(--color-primary);
    stroke: var(--color-dark);
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
