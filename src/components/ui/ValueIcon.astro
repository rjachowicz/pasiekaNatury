---
export type ValueIconName = "heart" | "leaf" | "tree" | "honey-jar";

interface Props {
  name: ValueIconName;
  size?: number | string;
  title?: string;
}

const { name, size = 76, title } = Astro.props;
const labelled = Boolean(title);
---

<svg
  class="value-icon"
  viewBox="0 0 100 115.47"
  width={size}
  height="auto"
  role={labelled ? "img" : undefined}
  aria-hidden={labelled ? undefined : "true"}
  aria-label={title}
>
  {title && <title>{title}</title>}
  <polygon
    class="value-icon__frame"
    points="50,1 99,29.29 99,86.18 50,114.47 1,86.18 1,29.29"
  />
  <g class="value-icon__glyph">
    {name === "heart" && (
      <path d="M50 75.5S31 64.8 31 51.7c0-6.3 4.5-10.7 10.4-10.7 3.7 0 6.8 1.8 8.6 4.8 1.8-3 4.9-4.8 8.6-4.8 5.9 0 10.4 4.4 10.4 10.7C69 64.8 50 75.5 50 75.5Z" />
    )}
    {name === "leaf" && (
      <>
        <path d="M69 39.5c-16.6.6-28.1 7.2-29.8 18.4-1.1 7.4 3.5 12.7 10.3 12.7C61.1 70.6 67.5 57.8 69 39.5Z" />
        <path d="M37.5 74.5c7.1-9.8 14.5-16.7 24.9-22.5" />
      </>
    )}
    {name === "tree" && (
      <>
        <path d="m50 35-13 15h8l-11 13.5h8l-11 14h38l-11-14h8L55 50h8L50 35Z" />
        <path d="M50 77.5v7" />
      </>
    )}
    {name === "honey-jar" && (
      <>
        <path d="M39 43h22M38 50h24l-1.7 24.4a4.5 4.5 0 0 1-4.5 4.2H44.2a4.5 4.5 0 0 1-4.5-4.2L38 50Z" />
        <path d="M41.5 43v-4h17v4M42.5 60h15M44.5 68h11" />
      </>
    )}
  </g>
</svg>

<style>
  .value-icon {
    display: block;
    overflow: visible;
  }

  .value-icon__frame {
    fill: var(--color-primary);
    stroke: var(--color-dark);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .value-icon__glyph {
    fill: none;
    stroke: var(--color-dark);
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .value-icon__glyph path:first-child {
    fill: color-mix(in srgb, var(--color-primary) 80%, white);
  }
</style>
