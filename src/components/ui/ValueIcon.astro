---
import { valueIconSources, type ValueIconName } from "../../data/valueIcons";

interface Props {
  name: ValueIconName;
  size?: number | string;
  title?: string;
}

const { name, size = 76, title } = Astro.props;
const iconSize = typeof size === "number" ? `${size}px` : size;
---

<div class="value-icon" style={`--value-icon-size: ${iconSize}`}>
  <svg
    class="value-icon__hexagon"
    viewBox="0 0 100 115.47"
    role={title ? "img" : undefined}
    aria-hidden={title ? undefined : "true"}
    aria-label={title}
  >
    {title && <title>{title}</title>}
    <polygon
      fill="none"
      stroke="var(--color-primary)"
      stroke-width="2.6"
      stroke-linejoin="round"
      points="50,1 99,29.29 99,86.18 50,114.47 1,86.18 1,29.29"
    />
  </svg>
  <img class="value-icon__image" src={valueIconSources[name]} alt="" />
</div>

<style>
  .value-icon {
    position: relative;
    display: grid;
    width: var(--value-icon-size);
    aspect-ratio: 100 / 115.47;
    place-items: center;
  }

  .value-icon__hexagon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .value-icon__image {
    position: relative;
    width: 44%;
    height: 44%;
    object-fit: contain;
  }
</style>
