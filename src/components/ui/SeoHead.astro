---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { canonicalUrl, robotsDirective } from "../../config/siteUrl.mjs";
import { products } from "../../data/products";
import { site } from "../../data/site";
import { imageAssets, type ImageAssetPath } from "../../data/imageAssets";
import {
  createStructuredData,
  type BreadcrumbItem,
} from "../../utils/structuredData";

export type { BreadcrumbItem } from "../../utils/structuredData";

interface Props {
  title: string;
  description: string;
  image?: ImageAssetPath;
  imageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/assets/hero.png",
  imageAlt = "Ramka z pszczołami na tle pola rzepaku",
  breadcrumbs,
  noindex = false,
} = Astro.props;
if (!Astro.site) {
  throw new Error("Astro site configuration is required for SEO metadata.");
}

const siteUrl = Astro.site;
const canonical = canonicalUrl(Astro.url, siteUrl);
const imageAsset: ImageMetadata = imageAssets[image];
const isLogo = image === "/assets/logo.png";
const socialImage = await getImage({
  src: imageAsset,
  width: Math.min(imageAsset.width, 1200),
  ...(isLogo
    ? { format: "png" as const }
    : { format: "webp" as const, quality: 82 }),
});
const imageUrl = new URL(socialImage.src, siteUrl);
const logoUrl = new URL(imageAssets["/assets/logo.png"].src, siteUrl);
const imageType = isLogo ? "image/png" : "image/webp";
const socialImageAlt = isLogo ? "Logo Pasieki 100% Natury" : imageAlt;
const robots = noindex
  ? import.meta.env.VERCEL_ENV === "preview"
    ? "noindex,nofollow"
    : "noindex"
  : robotsDirective(import.meta.env.VERCEL_ENV);
const structuredData = createStructuredData({
  siteUrl,
  pageUrl: canonical,
  title,
  description,
  imageUrl,
  imageWidth: socialImage.attributes.width,
  imageHeight: socialImage.attributes.height,
  imageType,
  logoUrl,
  breadcrumbs,
  catalogProducts:
    Astro.url.pathname.replace(/\/+$/, "") === "/produkty"
      ? products
      : undefined,
});
const googleSiteVerification =
  Astro.url.pathname === "/"
    ? import.meta.env.GOOGLE_SITE_VERIFICATION?.trim()
    : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={socialImageAlt} />
<meta
  property="og:image:width"
  content={String(socialImage.attributes.width)}
/>
<meta
  property="og:image:height"
  content={String(socialImage.attributes.height)}
/>
<meta property="og:image:type" content={imageType} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={socialImageAlt} />
{googleSiteVerification && (
  <meta name="google-site-verification" content={googleSiteVerification} />
)}
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
