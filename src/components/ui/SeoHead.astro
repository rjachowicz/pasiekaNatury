---
import type { ImageMetadata } from "astro";
import { contact } from "../../data/site";
import { imageAssets, type ImageAssetPath } from "../../data/imageAssets";

export interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  image?: ImageAssetPath;
  imageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  image = "/assets/hero.jpg",
  imageAlt = "Pszczoła wśród kwiatów — Pasieka 100% Natury",
  breadcrumbs,
} = Astro.props;
const site = Astro.site ?? new URL("https://pasiekanatury.vercel.app");
const canonical = new URL(Astro.url.pathname, site);
const imageAsset: ImageMetadata = imageAssets[image];
const imageUrl = new URL(imageAsset.src, site);
const logoUrl = new URL(imageAssets["/assets/logo.png"].src, site);
const imageType =
  image.endsWith(".jpg") || image.endsWith(".jpeg")
    ? "image/jpeg"
    : image.endsWith(".png")
      ? "image/png"
      : `image/${imageAsset.format}`;
const organization = {
  "@type": "LocalBusiness",
  "@id": new URL("/#organization", site).href,
  name: "Pasieka 100% Natury",
  url: new URL("/", site).href,
  logo: logoUrl.href,
  telephone: contact.phones[0].display,
  contactPoint: contact.phones.map(({ display }) => ({
    "@type": "ContactPoint",
    telephone: display,
    contactType: "customer service",
    availableLanguage: "pl",
  })),
  email: contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jasienna 171",
    postalCode: "33-322",
    addressLocality: "Korzenna",
    addressCountry: "PL",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: contact.coordinates.latitude,
    longitude: contact.coordinates.longitude,
  },
  hasMap: contact.directionsUrl,
  sameAs: [contact.facebookUrl, contact.instagramUrl],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    ...(breadcrumbs?.length
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: breadcrumbs.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.name,
              item: new URL(item.path, site).href,
            })),
          },
        ]
      : []),
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pl_PL" />
<meta property="og:site_name" content="Pasieka 100% Natury" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(imageAsset.width)} />
<meta property="og:image:height" content={String(imageAsset.height)} />
<meta property="og:image:type" content={imageType} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
