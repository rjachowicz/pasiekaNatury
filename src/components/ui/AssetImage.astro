---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { imageAssets, type ImageAssetPath } from "../../data/imageAssets";

interface Props extends Omit<
  HTMLAttributes<"img">,
  "src" | "width" | "height"
> {
  src: ImageAssetPath;
  alt: string;
  widths?: number[];
}

const { src, alt, widths: requestedWidths, sizes, ...attributes } = Astro.props;
const asset: ImageMetadata | undefined = imageAssets[src];
if (!asset) throw new Error(`Unknown local image: ${src}`);
const isLogo = src === "/assets/logo.png";
const defaultWidths = isLogo ? [120, 240] : [320, 640];
const requestedCandidates = [
  ...new Set(
    (requestedWidths ?? defaultWidths).filter(
      (width) => Number.isFinite(width) && width > 0 && width <= asset.width,
    ),
  ),
].sort((a, b) => a - b);
const widths =
  requestedCandidates.length > 0 ? requestedCandidates : [asset.width];
---

<Image
  {...attributes}
  src={asset}
  alt={alt}
  width={widths[widths.length - 1]}
  widths={widths}
  sizes={sizes ?? (isLogo ? "120px" : "100vw")}
  format="webp"
  quality={82}
/>
