---
import AssetImage from "./AssetImage.astro";

interface Props {
  variant?: "header" | "footer";
  loading?: "eager" | "lazy";
}

const { variant = "header", loading = "eager" } = Astro.props;
---

<a
  class:list={["brand-lockup", `brand-lockup--${variant}`]}
  href="/"
  aria-label="Pasieka 100% Natury — strona główna"
>
  <AssetImage
    class="brand-lockup__mark"
    src="/assets/logo.png"
    widths={[120, 240]}
    sizes={variant === "header" ? "144px" : "132px"}
    loading={loading}
    alt=""
  />
  <span class="brand-lockup__name">
    Pasieka <strong>100% Natury</strong>
  </span>
</a>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    position: relative;
    display: grid;
    grid-template-columns: 144px minmax(104px, 1fr);
    width: 290px;
    height: 110px;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--color-white);
  }

  .brand-lockup__mark {
    position: absolute;
    top: 2px;
    left: 0;
    width: 144px;
  }

  .brand-lockup__name {
    display: grid;
    grid-column: 2;
    max-width: 9ch;
    font: 500 clamp(1.05rem, 1.25vw, 1.25rem) / 0.98 var(--font-heading);
    letter-spacing: -0.02em;
  }

  .brand-lockup__name strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .brand-lockup--footer .brand-lockup__mark {
    width: 132px;
  }

  .brand-lockup--footer .brand-lockup__name {
    font-size: 1.1rem;
  }

  .brand-lockup--footer {
    grid-template-columns: 132px minmax(112px, 1fr);
    width: 278px;
    height: 132px;
  }

  @media (max-width: 639px) {
    .brand-lockup--header {
      grid-template-columns: 96px minmax(0, 1fr);
      width: min(222px, calc(100% - 48px));
      height: 82px;
      gap: 8px;
    }

    .brand-lockup--header .brand-lockup__mark {
      top: 1px;
      width: 96px;
    }

    .brand-lockup--header .brand-lockup__name {
      max-width: 9ch;
      font-size: 0.98rem;
    }

    .brand-lockup--footer .brand-lockup__name {
      max-width: 10ch;
      font-size: 1rem;
    }

    .brand-lockup--footer {
      grid-template-columns: 128px minmax(0, 1fr);
      width: 268px;
      height: 128px;
    }

    .brand-lockup--footer .brand-lockup__mark {
      width: 128px;
    }
  }
</style>
