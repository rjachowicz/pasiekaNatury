---
import Icon from "./Icon.astro";
import { contact } from "../../data/site";
---

<section class="google-map" aria-label="Mapa dojazdu">
  <div class="google-map__placeholder">
    <Icon name="location" size={42} />
    <div>
      <p class="eyebrow">Lokalizacja</p>
      <address>
        {contact.addressLines.map((line) => (
          <span>{line}</span>
        ))}
      </address>
    </div>
    <div class="google-map__actions">
      <button type="button" data-enable-google-map>
        Włącz mapę Google
      </button>
      <a href={contact.directionsUrl} target="_blank" rel="noopener noreferrer">
        Otwórz w Google Maps <Icon name="arrow-up-right" size={17} />
      </a>
    </div>
  </div>
  <iframe
    class="google-map__iframe"
    data-src={contact.mapEmbedUrl}
    title="Mapa dojazdu do Pasieki 100% Natury"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    hidden
  ></iframe>
</section>

<script>
  import {
    getPrivacyPreferences,
    privacyPreferencesEvent,
  } from "../../scripts/privacyPreferences";

  const map = document.querySelector<HTMLElement>(".google-map");
  const iframe = map?.querySelector<HTMLIFrameElement>(".google-map__iframe");
  const placeholder = map?.querySelector<HTMLElement>(
    ".google-map__placeholder",
  );
  const enableButton = map?.querySelector<HTMLButtonElement>(
    "[data-enable-google-map]",
  );

  const loadMap = () => {
    if (!iframe) return;
    if (!iframe.getAttribute("src")) iframe.src = iframe.dataset.src ?? "";
    placeholder?.setAttribute("hidden", "");
    iframe.removeAttribute("hidden");
    map?.setAttribute("data-map-ready", "true");
  };

  const unloadMap = () => {
    if (!iframe) return;
    iframe.removeAttribute("src");
    iframe.setAttribute("hidden", "");
    placeholder?.removeAttribute("hidden");
    map?.removeAttribute("data-map-ready");
  };

  const hasConsent = () => getPrivacyPreferences()?.googleMaps === true;

  if (hasConsent()) loadMap();

  enableButton?.addEventListener("click", () => {
    if (hasConsent()) {
      loadMap();
      return;
    }
    window.dispatchEvent(new CustomEvent("pasieka:open-privacy-settings"));
  });

  window.addEventListener(privacyPreferencesEvent, (event) => {
    if ((event as CustomEvent<{ googleMaps: boolean }>).detail.googleMaps) {
      loadMap();
      return;
    }
    unloadMap();
  });
</script>

<style>
  .google-map {
    position: relative;
    min-height: 440px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-image);
    background: var(--color-soft);
  }

  .google-map__placeholder {
    display: grid;
    min-height: 440px;
    padding: var(--space-4);
    place-items: center;
    align-content: center;
    background: var(--color-soft);
    text-align: center;
  }

  .google-map__placeholder > :global(svg) {
    margin-bottom: var(--space-2);
    color: var(--color-primary);
  }

  .google-map address {
    display: grid;
    margin-top: var(--space-2);
    font: 500 var(--text-card-title)/1.2 var(--font-heading);
    font-style: normal;
  }

  .google-map__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .google-map__actions button,
  .google-map__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    gap: 8px;
    padding: 12px 18px;
    border: 1px solid var(--color-dark);
    border-radius: var(--radius-pill);
    background: var(--color-dark);
    color: var(--color-white);
    font: 700 var(--text-eyebrow)/1.4 var(--font-body);
    letter-spacing: 0.035em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform var(--transition),
      background-color var(--transition),
      border-color var(--transition);
  }

  .google-map__actions button:hover,
  .google-map__actions a:hover {
    transform: translateY(-2px);
  }

  .google-map__actions a {
    border-color: var(--color-border);
    background: var(--color-white-72);
    color: var(--color-text);
  }

  .google-map__iframe {
    width: 100%;
    min-height: 440px;
    border: 0;
    background: var(--color-soft);
  }

  .google-map__placeholder[hidden],
  .google-map__iframe[hidden] {
    display: none !important;
  }

  @media (max-width: 479px) {
    .google-map,
    .google-map__placeholder,
    .google-map__iframe {
      min-height: 380px;
    }

    .google-map__actions {
      display: grid;
      width: 100%;
    }
  }
</style>
