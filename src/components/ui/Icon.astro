---
export type IconName =
  "phone" | "email" | "location" | "facebook" | "instagram" | "arrow-up-right";

interface Props {
  name: IconName;
  size?: number | string;
  title?: string;
}

const { name, size = 24, title } = Astro.props;
const labelled = Boolean(title);
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={labelled ? "img" : undefined}
  aria-hidden={labelled ? undefined : "true"}
  aria-label={title}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {title && <title>{title}</title>}
  {name === "phone" && (
    <path d="M7.2 3.5 5.4 5.1c-.6.6-.8 1.5-.5 2.3 1.7 4.6 5.3 8.2 9.9 9.9.8.3 1.7.1 2.3-.5l1.6-1.8-3.1-2.1-1.5 1c-1.8-.9-3-2.1-3.9-3.9l1-1.5-2-3Z" />
  )}
  {name === "email" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === "location" && (
    <>
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {name === "facebook" && (
    <path d="M14.5 21v-8h2.8l.4-3h-3.2V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2H8.5v3h2.8v8" />
  )}
  {name === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5h.01" />
    </>
  )}
  {name === "arrow-up-right" && <path d="M6 18 18 6M9 6h9v9" />}
</svg>
