---
import Icon, { type IconName } from "./Icon.astro";
import { contact } from "../../data/site";

interface Props {
  prominent?: boolean;
}

const { prominent = false } = Astro.props;

const details = [
  ...contact.phones.map(({ label, display, href }) => ({
    label,
    text: display,
    href,
    icon: "phone" as const,
  })),
  {
    label: "E-mail",
    text: contact.email,
    href: `mailto:${contact.email}`,
    icon: "email",
  },
  { label: "Adres", text: contact.address, href: "", icon: "location" },
] satisfies { label: string; text: string; href: string; icon: IconName }[];
---

<address
  class:list={[
    "contact-details",
    "contact-details--compact",
    { "contact-details--prominent": prominent },
  ]}
>
  {details.map(({ label, text, href, icon }) => {
    const Tag = href ? "a" : "div";
    return (
      <Tag class="contact-row" href={href || undefined}>
        <span class="contact-row__icon">
          <Icon name={icon} size={prominent ? 26 : 22} />
        </span>
        <span class="contact-row__content">
          <span class="contact-row__label">{label}</span>
          <span class="contact-row__value">{text}</span>
        </span>
      </Tag>
    );
  })}
</address>

<style>
  .contact-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-3);
    font-style: normal;
  }
  .contact-details--compact {
    grid-template-columns: 1fr;
  }
  .contact-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 78px;
    padding: var(--space-2) 0;
    border-bottom: var(--border);
    font-size: var(--text-small);
    min-width: 0;
    word-break: normal;
    overflow-wrap: break-word;
  }
  .contact-row__content {
    min-width: 0;
  }
  a.contact-row:hover {
    color: var(--color-dark);
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 4px;
  }
  .contact-row__label {
    display: block;
    margin-bottom: 2px;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .contact-row__icon {
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    color: var(--color-primary);
  }
  .contact-details--prominent .contact-row {
    min-height: 86px;
  }
  .contact-details--prominent .contact-row__icon {
    flex-basis: 42px;
    width: 42px;
    height: 42px;
  }
  .contact-details--prominent .contact-row__value {
    color: var(--color-dark);
    font-size: var(--text-body);
    font-weight: 600;
  }
  @media (max-width: 639px) {
    .contact-row {
      min-height: 72px;
      padding-block: 12px;
    }
  }
  @media (max-width: 479px) {
    .contact-details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 359px) {
    .contact-row__content {
      overflow-wrap: anywhere;
    }
  }
</style>
