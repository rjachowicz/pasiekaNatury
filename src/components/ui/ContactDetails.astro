---
import Icon, { type IconName } from "./Icon.astro";
import { contact } from "../../data/site";

interface Props {
  variant?: "compact" | "tiles";
}

const { variant = "compact" } = Astro.props;
const details = [
  {
    label: "Telefon",
    text: contact.phone,
    href: contact.phoneHref,
    icon: "phone",
  },
  {
    label: "E-mail",
    text: contact.email,
    href: `mailto:${contact.email}`,
    icon: "email",
  },
  { label: "Adres", text: contact.address, href: "", icon: "location" },
] satisfies { label: string; text: string; href: string; icon: IconName }[];
---

<address class:list={["contact-details", `contact-details--${variant}`]}>
  {details.map(({ label, text, href, icon }) => {
    const Tag = href ? "a" : "div";
    return (
      <Tag class="contact-row" href={href || undefined}>
        <span class="contact-row__hex">
          <Icon name={icon} size={22} />
        </span>
        <span>
          <span class="contact-row__label">{label}</span>
          <span>{text}</span>
        </span>
      </Tag>
    );
  })}
</address>

<style>
  .contact-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-3);
    font-style: normal;
  }
  .contact-details--compact {
    grid-template-columns: 1fr;
  }
  .contact-details--tiles {
    gap: var(--space-3);
  }
  .contact-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 78px;
    padding: var(--space-2) 0;
    border-bottom: var(--border);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }
  .contact-details--tiles .contact-row {
    min-height: 132px;
    padding: var(--space-3);
    border: var(--border);
    background: var(--color-white);
  }
  .contact-row > span:last-child {
    min-width: 0;
  }
  a.contact-row:hover {
    color: var(--color-dark);
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 4px;
  }
  .contact-row__label {
    display: block;
    margin-bottom: 2px;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .contact-row__hex {
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    color: var(--color-primary);
  }
  .contact-details--tiles .contact-row__hex {
    flex-basis: 46px;
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-primary);
  }
  @media (max-width: 639px) {
    .contact-details--tiles {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .contact-row {
      min-height: 72px;
      padding-block: 12px;
    }
    .contact-details--tiles .contact-row {
      min-height: 96px;
    }
  }
  @media (max-width: 479px) {
    .contact-details {
      grid-template-columns: 1fr;
    }
  }
</style>
