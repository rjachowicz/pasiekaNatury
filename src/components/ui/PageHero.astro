---
import AssetImage from "./AssetImage.astro";
import { type ImageAssetPath } from "../../data/imageAssets";

interface Props {
  eyebrow: string;
  title: string;
  image?: ImageAssetPath;
  imageAlt?: string;
  imagePosition?: string;
}
const {
  eyebrow,
  title,
  image,
  imageAlt = "",
  imagePosition = "center",
} = Astro.props;
---

<section class:list={["page-hero", { "page-hero--image": image }]}>
  <div class="page-hero__inner">
    <div class="page-hero__copy">
      <p class="eyebrow eyebrow--line">{eyebrow}</p>
      <h1>{title}</h1>
      <span class="accent-line" aria-hidden="true"></span>
      <div class="prose">
        <slot />
      </div>
    </div>
    {image && (
      <div
        class="page-hero__visual"
        aria-hidden={imageAlt ? undefined : "true"}
      >
        <AssetImage
          src={image}
          sizes="(max-width: 899px) 100vw, 58vw"
          widths={[640, 960, 1440]}
          loading="eager"
          fetchpriority="high"
          alt={imageAlt}
          style={`--page-hero-image-position: ${imagePosition}`}
        />
      </div>
    )}
  </div>
</section>
<style>
  .page-hero {
    background: var(--color-soft);
  }
  .page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    min-height: var(--hero-desktop-height);
  }
  .page-hero:not(.page-hero--image) .page-hero__inner {
    width: min(calc(100% - var(--gutter) * 2), var(--container-content));
    margin-inline: auto;
    grid-template-columns: 1fr;
    min-height: var(--hero-desktop-height);
  }
  .page-hero__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--hero-copy-padding-block) var(--space-grid)
      var(--hero-copy-padding-block) var(--page-inset);
  }
  .page-hero:not(.page-hero--image) .page-hero__copy {
    padding-inline: 0;
  }
  .page-hero__visual {
    position: relative;
    min-width: 0;
    min-height: var(--hero-desktop-height);
    overflow: hidden;
    background: var(--color-soft);
  }
  .page-hero__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--page-hero-image-position);
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 18%,
      #000 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 100%);
  }
  h1 {
    max-width: 24ch;
    font-size: var(--text-page-title);
  }

  .prose {
    max-width: 57ch;
  }

  .accent-line {
    margin-block: var(--space-3);
  }
  @media (max-width: 899px) {
    .page-hero__inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .page-hero__copy {
      padding: var(--hero-copy-padding-block) var(--page-inset);
    }
    .page-hero__visual {
      min-height: 0;
      height: var(--hero-tablet-visual-height);
    }
    .page-hero__visual :global(img) {
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 22%,
        #000 100%
      );
      mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 100%);
    }
  }

  @media (max-width: 639px) {
    .page-hero__visual {
      height: var(--hero-mobile-visual-height);
    }
  }
</style>
