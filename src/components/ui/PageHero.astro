---
import AssetImage from "./AssetImage.astro";
interface Props {
    eyebrow: string;
    title: string;
}
const {eyebrow, title} = Astro.props;
---

<section class="page-hero">
    <div class="container page-hero__inner">
        <div data-reveal>
            <p class="eyebrow eyebrow--line">{eyebrow}</p>
            <h1>{title}</h1>
            <span class="accent-line" aria-hidden="true"></span>
            <div class="prose">
                <slot/>
            </div>
        </div>
        <div class="page-hero__motif" aria-hidden="true">
            <AssetImage
                    src="/assets/bee-flight.png"
                    widths={[160, 320]}
                    sizes="160px"
                    alt=""
            />
            <span class="eyebrow">Blisko natury</span>
        </div>
    </div>
</section>
<style>
    .page-hero {
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: center;
        min-height: 350px;
        padding-block: 40px;
        background: linear-gradient(
                180deg,
                var(--color-soft) 60%,
                var(--color-white)
        );
    }

    .page-hero::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset: 0 0 0 auto;
        width: min(40%, 500px);
        background: url("/assets/honeycomb.png") left top / 650px auto no-repeat;
        opacity: 0.07;
        mask-image: linear-gradient(225deg, #000, transparent 75%);
        pointer-events: none;
    }

    .page-hero__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 240px;
        align-items: center;
        gap: var(--space-grid);
    }

    .eyebrow {
        margin-bottom: var(--space-2);
    }

    h1 {
        max-width: 24ch;
        font-size: var(--text-page-title);
    }

    .prose {
        max-width: 57ch;
    }

    .accent-line {
        margin-block: var(--space-3);
    }

    .page-hero__motif {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 200px;
        gap: var(--space-2);
        align-content: center;
    }

    .page-hero__motif img {
        position: relative;
        width: 180px;
        opacity: 0.45;
    }

    .page-hero__motif .eyebrow {
        position: relative;
        margin: 0;
        font-size: var(--text-eyebrow);
        color: var(--color-muted);
    }

    @media (max-width: 899px) {
        .page-hero {
            min-height: 320px;
        }

        .page-hero__inner {
            grid-template-columns: minmax(0, 1fr) 160px;
            gap: var(--space-4);
        }

        .page-hero__motif {
            min-height: 140px;
        }

        .page-hero__motif img {
            width: 130px;
        }
    }

    @media (max-width: 639px) {
        .page-hero {
            min-height: 0;
            padding-block: 48px 40px;
        }

        .page-hero::before {
            width: 120px;
            opacity: 0.04;
        }

        .page-hero__inner {
            grid-template-columns: 1fr;
        }

        .page-hero__motif {
            display: none;
        }
    }
</style>
