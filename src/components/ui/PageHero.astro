---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero__inner">
    <div data-reveal>
      <p class="eyebrow eyebrow--line">{eyebrow}</p>
      <h1>{title}</h1>
      <span class="accent-line" aria-hidden="true"></span>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</section>
<style>
  .page-hero {
    display: flex;
    align-items: center;
    min-height: 270px;
    padding-block: 40px;
    background: var(--color-soft);
  }

  .page-hero__inner {
    width: 100%;
  }

  .eyebrow {
    margin-bottom: var(--space-2);
  }

  h1 {
    max-width: 24ch;
    font-size: var(--text-page-title);
  }

  .prose {
    max-width: 57ch;
  }

  .accent-line {
    margin-block: var(--space-3);
  }

  @media (max-width: 639px) {
    .page-hero {
      min-height: 220px;
      padding-block: 32px;
    }
  }
</style>
