---
import Button from "./Button.astro";
interface Props {
  title: string;
  href: string;
  label: string;
}
const { title, href, label } = Astro.props;
---

<section class="cta-section section section-divider">
  <div class="container cta-section__inner" data-reveal>
    <div>
      <h2>{title}</h2>
      <div class="prose">
        <slot />
      </div>
    </div>
    <Button href={href}>{label}</Button>
  </div>
</section>
<style>
  .cta-section {
    background: var(--color-soft);
    padding-block: var(--space-section-sm);
  }

  .cta-section__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-grid);
  }

  h2 {
    max-width: 22ch;
    font-size: var(--text-section-title);
  }

  .prose {
    margin-top: var(--space-2);
    max-width: 54ch;
  }

  .cta-section__inner > :global(.button) {
    flex-shrink: 0;
  }

  @media (max-width: 899px) {
    .cta-section__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
