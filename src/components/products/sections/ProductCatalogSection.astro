---
import ProductCard from "../ProductCard.astro";
import { productCategories, products } from "../../../data/products";
import { formatProductCount } from "../../../utils/formatProductCount";
---

<div class="catalog-heading" data-reveal>
  <div>
    <h2>Katalog według rodzaju produktów</h2>
    <p>Wybierz kategorię lub obejrzyj całość katalogu produktów z pasieki.</p>
  </div>
  <span data-product-count aria-live="polite">
    {formatProductCount(products.length)}
  </span>
</div>
<div class="product-filters" role="group" aria-label="Filtruj produkty">
  <button type="button" data-product-filter="all" aria-pressed="true">
    Wszystkie
  </button>
  {productCategories.map(({ id, label }) => (
    <button type="button" data-product-filter={id} aria-pressed="false">
      {label}
    </button>
  ))}
</div>
<p class="empty-products" data-empty-products hidden>
  Produkty z tej kategorii pojawią się wkrótce.
</p>
{productCategories.map(({ id, label }) => {
  const categoryProducts = products.filter(
    (product) => product.category === id,
  );
  return (
    <section
      class="product-group"
      data-product-group={id}
      aria-labelledby={`category-${id}`}
    >
      <h3 id={`category-${id}`}>{label}</h3>
      <div class="product-grid">
        {categoryProducts.map((product) => (
          <ProductCard product={product} index={products.indexOf(product)} />
        ))}
      </div>
    </section>
  );
})}

<script>
  import "../../../scripts/productFilters";
</script>

<style>
  .catalog-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
  }
  .catalog-heading > div {
    min-width: 0;
  }
  .catalog-heading > span {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }
  .catalog-heading h2 {
    max-width: 20ch;
  }
  .catalog-heading p {
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--color-muted);
  }
  .product-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: var(--space-4);
    margin-top: var(--space-4);
    border-top: var(--border);
  }
  .product-filters button {
    min-height: 44px;
    padding: 8px var(--space-2);
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-dark);
    cursor: pointer;
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      background-color var(--transition),
      border-color var(--transition);
  }
  .product-filters button:hover,
  .product-filters button:focus-visible {
    border-color: var(--color-accent-border);
    background: var(--color-soft);
  }
  .product-filters button[aria-pressed="true"] {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }
  .empty-products {
    padding: var(--space-4) 0;
    color: var(--color-muted);
  }
  .product-group {
    margin-top: var(--space-5);
  }
  .product-group + .product-group {
    padding-top: var(--space-5);
    border-top: var(--border);
  }
  .product-group h3 {
    font-size: var(--text-card-title);
  }
  .product-grid {
    display: grid;
    grid-auto-rows: minmax(min-content, 1fr);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  @media (max-width: 1199px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 639px) {
    .catalog-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
