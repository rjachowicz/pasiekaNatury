---
import SectionHeading from "../../ui/SectionHeading.astro";
---

<div class="products-intro" data-reveal>
  <SectionHeading
    eyebrow="Prosto z pasieki"
    title="Oferta, która podąża za naturą"
  />
  <p class="products-intro__copy">
    Każdy produkt ma własny charakter, wynikający z pracy pszczół, miejsca i
    pory roku. Sprawdź, co jest obecnie prezentowane w katalogu.
  </p>
</div>

<style>
  .products-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: end;
    gap: var(--space-grid);
  }
  .products-intro :global(h2) {
    max-width: 18ch;
  }
  .products-intro__copy {
    max-width: 54ch;
    justify-self: end;
    color: var(--color-muted);
  }
  @media (max-width: 899px) {
    .products-intro {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .products-intro__copy {
      justify-self: start;
    }
  }
</style>
