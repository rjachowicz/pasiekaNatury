---
import AssetImage from "../../ui/AssetImage.astro";
import { isProductLogo, products, type Product } from "../../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const otherProducts = [
  ...products.filter(
    ({ id, category }) => id !== product.id && category === product.category,
  ),
  ...products.filter(
    ({ id, category }) => id !== product.id && category !== product.category,
  ),
].slice(0, 3);
---

{otherProducts.length > 0 && (
  <section class="other-products section--sm soft-section">
    <div class="container">
      <div class="other-products__heading">
        <p class="eyebrow eyebrow--line">Poznaj także</p>
        <h2>Zobacz także</h2>
      </div>
      <div class="other-products__grid">
        {otherProducts.map((other) => (
          <a href={`/produkty/${other.id}`}>
            <div
              class:list={[
                "other-products__image",
                { "other-products__image--photo": !isProductLogo(other) },
              ]}
              style={`--product-image-position: ${other.imagePosition ?? "center"}`}
            >
              <AssetImage
                src={other.image}
                sizes="(max-width: 639px) 112px, 132px"
                widths={[160, 320]}
                loading="lazy"
                alt={other.imageAlt}
              />
            </div>
            <div class="other-products__content">
              <span>
                {String(
                  products.findIndex(({ id }) => id === other.id) + 1,
                ).padStart(2, "0")}
              </span>
              <h3>{other.name}</h3>
              <p>{other.shortDescription}</p>
              <b aria-hidden="true">→</b>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .other-products__heading {
    margin-bottom: var(--space-4);
  }
  .other-products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .other-products__grid a {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    min-height: 240px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .other-products__grid a:hover,
  .other-products__grid a:focus-visible {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-subtle);
  }
  .other-products__image {
    display: grid;
    padding: var(--space-2);
    place-items: center;
    background: var(--color-soft);
  }
  .other-products__image--photo {
    position: relative;
    display: block;
    padding: 0;
    overflow: hidden;
  }
  .other-products__image--photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--product-image-position);
  }
  .other-products__image:not(.other-products__image--photo) :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .other-products__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-3);
  }
  .other-products__grid span {
    color: var(--color-primary-hover);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .other-products__grid h3 {
    font-size: 1.6rem;
  }
  .other-products__grid p {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .other-products__grid b {
    padding-top: var(--space-2);
    margin-top: auto;
    font-weight: 400;
  }
  @media (max-width: 899px) {
    .other-products__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 639px) {
    .other-products__grid a {
      grid-template-columns: 112px minmax(0, 1fr);
      min-height: 180px;
    }
  }
</style>
