---
import AssetImage from "../ui/AssetImage.astro";
import PageHero from "../ui/PageHero.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import CallToAction from "../ui/CallToAction.astro";
import ProductCard from "./ProductCard.astro";
import { products } from "../../data/products";
---

<>
  <PageHero eyebrow="Nasze produkty" title="Naturalne miody prosto z pasieki">
    <p>
      Cztery różne charaktery, jedna pasja. Odkryj smaki, które zmieniają się
      wraz z krajobrazem i porami roku.
    </p>
  </PageHero>
  <section class="section">
    <div class="container">
      <div class="products-intro" data-reveal>
        <SectionHeading
          eyebrow="Smak natury"
          title="Każdy pożytek to inna opowieść"
        />
        <p class="products-intro__copy">
          Delikatny czy wyrazisty? Kwiatowy czy leśny? Wybierz miód według
          swoich upodobań. Barwa, aromat i konsystencja mogą różnić się między
          zbiorami — to część ich naturalnego charakteru.
        </p>
      </div>
      <AssetImage
        class="products-photo"
        sizes="(max-width: 960px) 100vw, 900px"
        src="/assets/products.png"
        loading="lazy"
        alt="Miody faceliowy, lipowy, gryczany i spadziowy w czterech słoikach"
      />
      <div class="catalog-heading" data-reveal>
        <div>
          <h2>Nasze miody</h2>
        </div>
        <span>{String(products.length).padStart(2, "0")} rodzaje miodu</span>
      </div>
      <div class="product-grid">
        {products.map((product, index) => (
          <ProductCard product={product} index={index} />
        ))}
      </div>
    </div>
  </section>
  <aside class="product-guide container" aria-label="Jak wybierać miód">
    Jasne miody są zwykle łagodniejsze, a ciemniejsze mają wyraźniejszy aromat.
    Krystalizacja jest naturalnym procesem i nie zmienia wartości miodu.
  </aside>
  <CallToAction
    title="Zapytaj o dostępność"
    href="/kontakt"
    label="Zapytaj o dostępność"
  >
    <p>
      Dostępność miodów zależy od sezonu i zbiorów. Skontaktuj się z nami, aby
      poznać aktualną ofertę.
    </p>
  </CallToAction>
</>
<style>
  .products-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: end;
    gap: var(--space-grid);
  }

  .products-intro :global(h2) {
    max-width: 18ch;
  }

  .products-intro__copy {
    max-width: 54ch;
    justify-self: end;
    color: var(--color-muted);
  }

  .products-photo {
    width: min(100%, 900px);
    margin: clamp(2.5rem, 7vw, 5.5rem) auto var(--space-section-sm);
  }

  .catalog-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-bottom: var(--space-3);
  }

  .catalog-heading > span {
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .catalog-heading h2 {
    margin-top: var(--space-1);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .product-guide {
    max-width: var(--container-content);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-section-sm);
    border-left: 3px solid var(--color-primary);
    background: var(--color-soft);
    color: var(--color-muted);
  }

  @media (max-width: 1199px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 899px) {
    .products-intro {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .products-intro__copy {
      justify-self: start;
    }
  }

  @media (max-width: 639px) {
    .products-photo {
      margin-block: var(--space-4);
    }

    .catalog-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
