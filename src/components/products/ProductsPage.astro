---
import AssetImage from "../ui/AssetImage.astro";
import PageHero from "../ui/PageHero.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import CallToAction from "../ui/CallToAction.astro";
import ProductCard from "./ProductCard.astro";
import FeatureTile from "../ui/FeatureTile.astro";
import { products } from "../../data/products";
---

<>
  <PageHero eyebrow="Nasze produkty" title="Naturalne miody prosto z pasieki">
    <p>
      Cztery różne charaktery, jedna pasja. Odkryj smaki, które zmieniają się
      wraz z krajobrazem i porami roku.
    </p>
  </PageHero>
  <section class="section">
    <div class="container">
      <div class="products-intro">
        <SectionHeading
          eyebrow="Smak natury"
          title="Każdy pożytek to inna opowieść"
        />
        <p class="prose">
          Delikatny czy wyrazisty? Kwiatowy czy leśny? Wybierz miód według
          swoich upodobań. Barwa, aromat i konsystencja mogą różnić się między
          zbiorami — to część ich naturalnego charakteru.
        </p>
      </div>
      <AssetImage
        class="products-photo"
        sizes="(max-width: 1200px) 92vw, 1120px"
        src="/assets/products.png"
        loading="lazy"
        alt="Miody faceliowy, lipowy, gryczany i spadziowy w czterech słoikach"
      />
      <div class="catalog-heading">
        <p class="eyebrow eyebrow--line">Wybierz swój smak</p>
        <span>{String(products.length).padStart(2, "0")} / Nasze miody</span>
      </div>
      <div class="product-grid">
        {products.map((product, index) => (
          <ProductCard product={product} index={index} />
        ))}
      </div>
    </div>
  </section>
  <section
    class="section--sm soft-section section-divider"
    aria-label="Blisko natury"
  >
    <div class="container feature-grid">
      <FeatureTile
        title="100% natury"
        description="Barwa, aromat i konsystencja mogą różnić się między zbiorami. To część naturalnego charakteru miodu."
        icon="icon-leaf.png"
      />
      <FeatureTile
        title="Wędrowna pasieka"
        description="Podążamy za kwitnieniem. Każdy pożytek nadaje naszym miodom inny smak i aromat."
        icon="icon-maple.png"
      />
      <FeatureTile
        title="Tradycja i jakość"
        description="Pszczelarskie rzemiosło i uważność na każdym etapie pracy przy pasiece."
        icon="icon-honey.png"
      />
    </div>
  </section>
  <CallToAction
    title="Zapytaj o dostępność"
    href="/kontakt"
    label="Zapytaj o dostępność"
  >
    <p>
      Dostępność miodów zależy od sezonu i zbiorów. Skontaktuj się z nami, aby
      poznać aktualną ofertę.
    </p>
  </CallToAction>
</>
<style>
  .products-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-grid);
  }

  .products-intro :global(h2) {
    max-width: 18ch;
  }

  .products-photo {
    width: min(100%, 1120px);
    margin: var(--space-5) auto var(--space-section-sm);
  }

  .catalog-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 24px;
    border-top: 1px solid var(--color-border);
  }

  .catalog-heading > span {
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  @media (max-width: 1199px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 899px) {
    .products-intro {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (max-width: 639px) {
    .products-photo {
      margin-block: var(--space-4);
    }

    .catalog-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
