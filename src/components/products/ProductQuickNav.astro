---
import { products } from "../../data/products";
---

<nav class="product-quick-nav" aria-label="Szybki wybór miodu">
  <div class="product-quick-nav__track">
    {products.map((product, index) => (
      <a href={`#${product.id}`}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        {product.name.replace("Miód ", "")}
      </a>
    ))}
  </div>
</nav>

<style>
  .product-quick-nav {
    border-block: var(--border);
  }

  .product-quick-nav__track {
    display: flex;
    min-width: max-content;
  }

  a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
    padding: 0 clamp(1.1rem, 3vw, 2rem);
    border-right: var(--border);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    scroll-snap-align: start;
  }

  a:first-child {
    border-left: var(--border);
  }

  a:hover,
  a:focus-visible {
    background: var(--color-soft);
  }

  span {
    color: var(--color-primary-hover);
  }

  @media (max-width: 639px) {
    .product-quick-nav {
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .product-quick-nav::-webkit-scrollbar {
      display: none;
    }

    .product-quick-nav__track {
      padding-inline: var(--gutter);
    }
  }
</style>
