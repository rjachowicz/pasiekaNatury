---
import AssetImage from "../ui/AssetImage.astro";
import type { Product } from "../../data/products";
interface Props {
  product: Product;
  index: number;
}
const { product, index } = Astro.props;
const tags = product.character
  .replace(/\.$/, "")
  .split(",")
  .map((tag) => tag.trim());
---

<article
  class="product-card"
  id={product.id}
  aria-labelledby={`title-${product.id}`}
  data-reveal
>
  <div class="product-card__preview">
    <div
      class="product-card__crop"
      data-sprite-index={product.preview.index}
      style={`--sprite-width: ${product.preview.columns * 100}%; --sprite-left: ${product.preview.index * -100}%;`}
    >
      <AssetImage
        class="product-card__sprite"
        src={product.preview.src}
        widths={[960, 1440, 2010]}
        sizes="960px"
        loading="lazy"
        alt={`Słoik — ${product.name.toLocaleLowerCase("pl")}`}
      />
    </div>
  </div>
  <div class="product-card__body">
    <p class="product-card__meta">
      <span>{String(index + 1).padStart(2, "0")}</span> / Z naszej pasieki
    </p>
    <h2 id={`title-${product.id}`}>{product.name}</h2>
    <p class="product-card__description">{product.description}</p>
    <ul class="product-card__tags" aria-label="Nuty smakowe">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <p class="product-card__detail">{product.detail}</p>
    <dl>
      <div>
        <dt>Charakter</dt>
        <dd>{product.character}</dd>
      </div>
      <div>
        <dt>Gramatury</dt>
        <dd>{product.sizes || "Zapytaj nas o aktualne rozmiary słoików."}</dd>
      </div>
    </dl>
    <a
      class="text-link"
      href="/kontakt"
      aria-label={`Zapytaj o dostępność: ${product.name}`}
    >
      Zapytaj o dostępność
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
<style>
  .product-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
    scroll-margin-top: 120px;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: #c2ac70;
    box-shadow: 0 6px 20px #22222205;
  }

  .product-card__preview {
    display: grid;
    place-items: center;
    height: 340px;
    background: var(--color-soft);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .product-card__preview::after {
    content: "";
    position: absolute;
    left: 32px;
    bottom: -1px;
    width: 40px;
    height: 2px;
    background: var(--color-primary);
    transition: width var(--transition);
  }

  .product-card:hover .product-card__preview::after {
    width: 80px;
  }

  .product-card__crop {
    position: relative;
    width: 216px;
    height: 336px;
    overflow: hidden;
  }

  .product-card__sprite {
    position: absolute;
    left: var(--sprite-left);
    top: 0;
    width: var(--sprite-width);
    max-width: none;
    height: auto;
  }

  .product-card__crop[data-sprite-index="1"] {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 12% 100%, 12% 72%, 0 62%);
  }

  .product-card__crop[data-sprite-index="2"] {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 10% 100%, 10% 84%, 0 75%);
  }

  .product-card__crop[data-sprite-index="3"] {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 6% 100%, 6% 88%, 0 82%);
  }

  .product-card__body {
    padding: 32px;
  }

  .product-card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-card__meta span {
    color: var(--color-dark);
    font-size: var(--text-eyebrow);
  }

  h2 {
    font-size: var(--text-card-title);
  }

  .product-card__description {
    margin-top: 16px;
    max-width: 46ch;
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 20px 0;
    list-style: none;
  }

  .product-card__tags li {
    padding: 5px 9px;
    border: 1px solid var(--color-border);
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .product-card__detail {
    color: var(--color-muted);
    font-size: var(--text-small);
    max-width: 52ch;
  }

  dl {
    margin: 24px 0 16px;
  }

  dl > div {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--color-border);
  }

  dt {
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  @media (min-width: 640px) and (max-width: 1199px) {
    .product-card {
      display: grid;
      grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
    }

    .product-card__preview {
      height: 100%;
      min-height: 400px;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
  }

  @media (max-width: 639px) {
    .product-card__preview {
      height: 290px;
    }

    .product-card__crop {
      width: 184px;
      height: 286px;
    }

    .product-card__body {
      padding: 24px;
    }

    dl > div {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
