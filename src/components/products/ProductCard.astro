---
import { isProductLogo, type Product } from "../../data/products";
import AssetImage from "../ui/AssetImage.astro";

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article
  class="product-card"
  id={product.id}
  aria-labelledby={`title-${product.id}`}
  data-product-category={product.category}
>
  <a
    class:list={[
      "product-card__image",
      { "product-card__image--photo": !isProductLogo(product) },
    ]}
    href={`/produkty/${product.id}`}
    tabindex="-1"
    aria-hidden="true"
    style={`--product-image-position: ${product.imagePosition ?? "center"}`}
  >
    <AssetImage
      src={product.image}
      sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1199px) 43vw, 283px"
      widths={[320, 480, 640, 768, 960]}
      loading="lazy"
      alt={product.imageAlt}
    />
  </a>
  <div class="product-card__body">
    <p class="product-card__number" aria-hidden="true">
      {number}
    </p>
    <h3 id={`title-${product.id}`}>{product.name}</h3>
    <ul
      class="product-card__tags"
      aria-label={`Cechy produktu: ${product.name}`}
    >
      {product.tags.slice(0, 3).map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <p class="product-card__description">{product.shortDescription}</p>
    <a class="text-link" href={`/produkty/${product.id}`}>
      Zobacz produkt <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.9fr) minmax(0, 1.1fr);
    height: 100%;
    min-width: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-white);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
    scroll-margin-top: 120px;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-subtle);
  }

  .product-card__image {
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 0;
    padding: var(--space-4);
    border-right: var(--border);
    background: var(--color-soft);
    overflow: hidden;
  }

  .product-card__image--photo {
    position: relative;
    display: block;
    padding: 0;
  }

  .product-card__image--photo :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--product-image-position);
  }

  .product-card__image:not(.product-card__image--photo) :global(img) {
    display: block;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    max-width: min(100%, 275px);
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .product-card__body {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 3.5vw, 3rem);
  }

  .product-card__number {
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h3 {
    font-size: var(--text-card-title);
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: flex-start;
    padding: 0;
    margin: var(--space-2) 0 var(--space-3);
    list-style: none;
  }

  .product-card__tags li {
    padding: 5px 9px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .product-card__description {
    max-width: 45ch;
    color: var(--color-muted);
  }

  .text-link {
    margin-top: var(--space-3);
  }

  @media (max-width: 639px) {
    .product-card {
      grid-template-columns: 1fr;
    }

    .product-card__image {
      height: clamp(240px, 68vw, 300px);
      min-height: clamp(240px, 68vw, 300px);
      border-right: 0;
      border-bottom: var(--border);
    }

    .product-card__image:not(.product-card__image--photo) :global(img) {
      max-width: min(100%, 220px);
      max-height: 100%;
    }

    .product-card__body {
      height: auto;
    }
  }
</style>
