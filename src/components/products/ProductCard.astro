---
import type { Product } from "../../data/products";

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article
  class="product-card"
  id={product.id}
  aria-labelledby={`title-${product.id}`}
  data-reveal
>
  <a
    class="product-card__image"
    href={`/produkty/${product.id}`}
    tabindex="-1"
    aria-hidden="true"
  >
    <img src={product.image} width="480" height="520" loading="lazy" alt="" />
  </a>
  <div class="product-card__body">
    <p class="product-card__number" aria-hidden="true">
      {number}
    </p>
    <h2 id={`title-${product.id}`}>{product.name}</h2>
    <ul class="product-card__tags" aria-label={`Nuty smakowe: ${product.name}`}>
      {product.tags.slice(0, 3).map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <p class="product-card__description">{product.shortDescription}</p>
    <a class="text-link" href={`/produkty/${product.id}`}>
      Zobacz produkt <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.9fr) minmax(0, 1.1fr);
    min-width: 0;
    border: var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-white);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
    scroll-margin-top: 120px;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-subtle);
  }

  .product-card__image {
    display: grid;
    place-items: center;
    min-height: 320px;
    padding: var(--space-4);
    border-right: var(--border);
    background: var(--color-soft);
  }

  .product-card__image img {
    width: min(100%, 275px);
    max-height: 350px;
    object-fit: contain;
  }

  .product-card__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 3.5vw, 3rem);
  }

  .product-card__number {
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h2 {
    font-size: var(--text-card-title);
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: var(--space-2) 0 var(--space-3);
    list-style: none;
  }

  .product-card__tags li {
    padding: 5px 9px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .product-card__description {
    max-width: 45ch;
    color: var(--color-muted);
  }

  .text-link {
    margin-top: var(--space-3);
  }

  @media (max-width: 639px) {
    .product-card {
      grid-template-columns: 1fr;
    }

    .product-card__image {
      min-height: 270px;
      border-right: 0;
      border-bottom: var(--border);
    }

    .product-card__image img {
      width: min(100%, 220px);
      max-height: 250px;
    }
  }
</style>
