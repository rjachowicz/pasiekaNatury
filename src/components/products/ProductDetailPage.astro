---
import Button from "../ui/Button.astro";
import AssetImage from "../ui/AssetImage.astro";
import { products, type Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const otherProducts = products.filter(({ id }) => id !== product.id);
const eyebrow =
  product.category === "honey"
    ? "Miód z naszej pasieki"
    : "Produkt pszczelarski";
---

<section class="product-detail section">
  <div class="container">
    <nav class="breadcrumb" aria-label="Okruszki">
      <a href="/">Strona główna</a>
      <span aria-hidden="true">/</span>
      <a href="/produkty">Produkty</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="product-detail__hero">
      <div class="product-detail__image" data-reveal>
        <AssetImage
          src={product.image}
          sizes="(max-width: 899px) 280px, 390px"
          loading="eager"
          fetchpriority="high"
          alt={`Produkt: ${product.name.toLocaleLowerCase("pl")}`}
        />
      </div>
      <div class="product-detail__content" data-reveal>
        <p class="eyebrow eyebrow--line">{eyebrow}</p>
        <h1>{product.name}</h1>
        <p class="product-detail__lead">{product.shortDescription}</p>
        {product.details?.length ? (
          <dl class="product-detail__details">
            {product.details.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))}
          </dl>
        ) : null}
        <ul
          class="product-detail__tags"
          aria-label={`Cechy produktu: ${product.name}`}
        >
          {product.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <Button
          data-contact-link
          href={`/kontakt?produkt=${encodeURIComponent(product.id)}`}
        >
          Zapytaj o produkt
        </Button>
      </div>
    </div>

    <div class="product-detail__body">
      <div class="product-detail__description">
        <p class="eyebrow eyebrow--line">O produkcie</p>
        <h2>Poznaj produkt</h2>
        <p>{product.description}</p>
      </div>
      {(product.sizes?.length || product.variants?.length) && (
        <div class="product-detail__choices">
          {product.sizes?.length && (
            <section
              class="product-detail__sizes"
              aria-labelledby="sizes-title"
            >
              <p class="eyebrow eyebrow--line">Dostępne gramatury</p>
              <h2 id="sizes-title">Wybierz gramaturę</h2>
              <div
                class="product-detail__options"
                role="radiogroup"
                aria-labelledby="sizes-title"
              >
                {product.sizes.map((size) => (
                  <label>
                    <input type="radio" name="product-variant" value={size} />
                    <span>{size}</span>
                  </label>
                ))}
              </div>
            </section>
          )}
          {product.variants?.length && (
            <section
              class="product-detail__sizes"
              aria-labelledby="variants-title"
            >
              <p class="eyebrow eyebrow--line">Dostępne warianty</p>
              <h2 id="variants-title">Wybierz wariant</h2>
              <div
                class="product-detail__options"
                role="radiogroup"
                aria-labelledby="variants-title"
              >
                {product.variants.map((variant) => (
                  <label>
                    <input
                      type="radio"
                      name="product-variant"
                      value={variant}
                    />
                    <span>{variant}</span>
                  </label>
                ))}
              </div>
            </section>
          )}
        </div>
      )}
    </div>

    <aside class="product-detail__notice" aria-label="Informacja o dostępności">
      Prezentacja produktu ma charakter informacyjny i nie stanowi aktualnej
      oferty sprzedaży. Dostępność, gramatury, warianty i ceny mogą się
      zmieniać. Aby poznać aktualną ofertę, skontaktuj się z pasieką.
    </aside>
  </div>
</section>

{otherProducts.length > 0 && (
  <section class="other-products section--sm soft-section">
    <div class="container">
      <div class="other-products__heading">
        <p class="eyebrow eyebrow--line">Poznaj także</p>
        <h2>Zobacz także</h2>
      </div>
      <div class="other-products__grid">
        {otherProducts.map((other) => (
          <a href={`/produkty/${other.id}`}>
            <div class="other-products__image">
              <AssetImage
                src={other.image}
                sizes="(max-width: 639px) 96px, 132px"
                loading="lazy"
                alt=""
              />
            </div>
            <div class="other-products__content">
              <span>
                {String(
                  products.findIndex(({ id }) => id === other.id) + 1,
                ).padStart(2, "0")}
              </span>
              <h3>{other.name}</h3>
              <p>{other.shortDescription}</p>
              <b aria-hidden="true">→</b>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const contactLink = document.querySelector<HTMLAnchorElement>(
    "[data-contact-link]",
  );
  const variantInputs = [
    ...document.querySelectorAll<HTMLInputElement>(
      'input[name="product-variant"]',
    ),
  ];

  const updateContactLink = () => {
    const selectedVariant = variantInputs.find((input) => input.checked)?.value;
    if (!contactLink) return;

    const url = new URL(contactLink.href);
    if (selectedVariant) url.searchParams.set("wariant", selectedVariant);
    else url.searchParams.delete("wariant");
    contactLink.href = `${url.pathname}${url.search}`;
  };

  variantInputs.forEach((input) =>
    input.addEventListener("change", updateContactLink),
  );
</script>

<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-5);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .breadcrumb a:hover {
    color: var(--color-dark);
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-underline-offset: 4px;
  }

  .product-detail__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: stretch;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-image);
  }

  .product-detail__image {
    display: grid;
    min-height: 540px;
    padding: var(--space-5);
    place-items: center;
    border-right: var(--border);
    background: var(--color-soft);
  }

  .product-detail__image :global(img) {
    width: min(100%, 390px);
    max-height: 480px;
    object-fit: contain;
  }

  .product-detail__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 6vw, 5rem);
  }

  .product-detail__content h1 {
    margin-top: var(--space-2);
  }

  .product-detail__lead {
    max-width: 42ch;
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
  }

  .product-detail__details {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-4);
  }

  .product-detail__details div {
    display: grid;
    gap: 4px;
  }

  .product-detail__details dt {
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-detail__details dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .product-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: var(--space-3) 0 var(--space-4);
    list-style: none;
  }

  .product-detail__tags li,
  .product-detail__options span {
    padding: 5px 9px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }

  .product-detail__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.6fr);
    gap: var(--space-grid);
    max-width: 1040px;
    margin: var(--space-section-sm) auto;
  }

  .product-detail__description p:last-child {
    max-width: 58ch;
    margin-top: var(--space-3);
    color: var(--color-muted);
  }

  .product-detail__choices {
    display: grid;
    gap: var(--space-3);
  }

  .product-detail__sizes {
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-soft);
  }

  .product-detail__sizes h2 {
    font-size: var(--text-card-title);
  }

  .product-detail__options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--space-3);
  }

  .product-detail__options label {
    position: relative;
    cursor: pointer;
  }

  .product-detail__options input {
    position: absolute;
    opacity: 0;
  }

  .product-detail__options input:checked + span {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .product-detail__options input:focus-visible + span {
    outline: 2px solid var(--color-dark);
    outline-offset: 3px;
  }

  .product-detail__notice {
    max-width: 1040px;
    padding: var(--space-3) var(--space-4);
    margin-inline: auto;
    border: var(--border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .other-products__heading {
    margin-bottom: var(--space-4);
  }

  .other-products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .other-products__grid a {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    min-height: 240px;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .other-products__grid a:hover,
  .other-products__grid a:focus-visible {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-subtle);
  }

  .other-products__image {
    display: grid;
    padding: var(--space-2);
    place-items: center;
    background: var(--color-soft);
  }

  .other-products__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .other-products__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-3);
  }

  .other-products__grid span {
    color: var(--color-primary-hover);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .other-products__grid h3 {
    font-size: 1.6rem;
  }

  .other-products__grid p {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .other-products__grid b {
    padding-top: var(--space-2);
    margin-top: auto;
    font-weight: 400;
  }

  @media (max-width: 899px) {
    .product-detail__hero,
    .product-detail__body {
      grid-template-columns: 1fr;
    }

    .product-detail__image {
      min-height: 420px;
      border-right: 0;
      border-bottom: var(--border);
    }

    .other-products__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .breadcrumb {
      margin-bottom: var(--space-4);
    }

    .product-detail__image {
      min-height: 310px;
      padding: var(--space-3);
    }

    .product-detail__image :global(img) {
      width: min(100%, 250px);
      max-height: 280px;
    }

    .other-products__grid a {
      grid-template-columns: 112px minmax(0, 1fr);
      min-height: 180px;
    }

    .product-detail__body {
      margin-block: var(--space-section-sm);
    }
  }
</style>
