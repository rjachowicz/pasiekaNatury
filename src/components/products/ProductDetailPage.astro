---
import type { Product } from "../../data/products";
import ProductAvailabilityNotice from "./sections/ProductAvailabilityNotice.astro";
import ProductDescriptionSection from "./sections/ProductDescriptionSection.astro";
import ProductPresentationSection from "./sections/ProductPresentationSection.astro";
import RelatedProductsSection from "./sections/RelatedProductsSection.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<section class="product-detail section" data-product-detail>
  <div class="container">
    <ProductPresentationSection product={product} />
    <ProductDescriptionSection product={product} />
    <ProductAvailabilityNotice />
  </div>
</section>

<RelatedProductsSection product={product} />

<script>
  import "../../scripts/productVariant";
</script>

<style is:global>
  .product-detail__tags li,
  .product-detail__options span {
    padding: 5px 9px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: var(--text-eyebrow);
  }
</style>
