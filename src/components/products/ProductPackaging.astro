---
import type { Product } from "../../data/products";
import { formatPolishCurrency } from "../../utils/formatCurrency";

interface Props {
  product: Pick<Product, "packaging" | "priceOnRequest">;
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
const packaging = product.packaging;
const priceOnRequest = product.priceOnRequest === true;
const quantityLabel =
  packaging?.unit === "ml" ? "Objętość netto" : "Masa netto";
---

{(packaging || priceOnRequest) && (
  <dl
    class:list={[
      "product-packaging",
      { "product-packaging--compact": compact },
    ]}
  >
    {packaging && (
      <div class="product-packaging__price">
        <dt class="product-packaging__label">Cena za opakowanie</dt>
        <dd>{formatPolishCurrency(packaging.priceGrosze)}</dd>
      </div>
    )}
    {priceOnRequest && (
      <div class="product-packaging__price product-packaging__price--on-request">
        <dt class="product-packaging__label">Cena</dt>
        <dd>Cena ustalana indywidualnie</dd>
      </div>
    )}
    {packaging && (
      <div class="product-packaging__quantity">
        <dt class="product-packaging__label">{quantityLabel}</dt>
        <dd>
          {packaging.netQuantity}&nbsp;{packaging.unit}&nbsp;netto
        </dd>
      </div>
    )}
  </dl>
)}

<style>
  .product-packaging {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    width: 100%;
    padding: 0;
    margin: 0;
  }
  .product-packaging div {
    display: flex;
    min-width: 0;
  }
  .product-packaging__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .product-packaging dd {
    margin: 0;
  }
  .product-packaging__price dd {
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .product-packaging__price--on-request {
    flex: 1 1 100%;
  }
  .product-packaging__price--on-request dd {
    white-space: normal;
  }
  .product-packaging__quantity {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .product-packaging__quantity dd {
    white-space: nowrap;
  }
  .product-packaging--compact {
    gap: 4px var(--space-2);
  }
  .product-packaging--compact .product-packaging__price dd {
    font-size: 1.25rem;
  }
  .product-packaging--compact .product-packaging__quantity {
    font-size: var(--text-eyebrow);
  }
</style>
