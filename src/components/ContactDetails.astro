---
import AssetImage from './AssetImage.astro';
import { contact } from '../data/site';
const details = [
  { label: 'Telefon', text: contact.phone, href: contact.phoneHref, icon: 'icon-phone.png' },
  { label: 'E-mail', text: contact.email, href: `mailto:${contact.email}`, icon: 'icon-email.png' },
  { label: 'Adres', text: contact.address, href: '', icon: 'icon-location.png' },
  { label: 'Facebook', text: 'Facebook', href: contact.facebookUrl, icon: 'icon-facebook.png' },
];
---
<address class="contact-details" data-reveal-group>
  {details.map(({ label, text, href, icon }) => {
    const Tag = href ? 'a' : 'div';
    return <Tag class="contact-row" href={href || undefined} data-reveal>
      <span class="contact-row__hex"><AssetImage src={`/assets/${icon}`} loading="lazy" alt="" aria-hidden="true" /></span>
      <span><span class="contact-row__label">{label}</span><span>{text}</span></span>
    </Tag>;
  })}
</address>
<style>
  .contact-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; padding: 1px; background: var(--color-border); font-style: normal; }
  .contact-row { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 16px; min-height: 168px; padding: 24px; background: var(--color-white); font-size: .875rem; overflow-wrap: anywhere; transition: background-color var(--transition); }
  a.contact-row:hover { background: var(--color-soft); }
  .contact-row > span:last-child { min-width: 0; }
  a.contact-row:hover { text-decoration: underline; text-decoration-color: var(--color-primary); text-underline-offset: 4px; }
  .contact-row__label { display: block; margin-bottom: 3px; color: var(--color-muted); font-size: .6875rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .contact-row__hex { position: relative; flex: 0 0 44px; display: grid; place-items: center; width: 44px; height: 40px; }
  .contact-row__hex img { width: 25px; height: 25px; object-fit: contain; }
  @media (max-width: 639px) {
    .contact-details { grid-template-columns: 1fr; }
    .contact-row { flex-direction: row; align-items: center; justify-content: flex-start; min-height: 100px; padding: 20px; }
  }
</style>
