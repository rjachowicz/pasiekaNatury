---
import { contact } from '../data/site';
const details = [
  { label: 'Telefon', text: contact.phone, href: contact.phoneHref, icon: 'icon-phone.png' },
  { label: 'E-mail', text: contact.email, href: `mailto:${contact.email}`, icon: 'icon-email.png' },
  { label: 'Adres', text: contact.address, href: '', icon: 'icon-location.png' },
  { label: 'Facebook', text: 'Facebook', href: contact.facebookUrl, icon: 'icon-facebook.png' },
];
---
<address class="contact-details">
  {details.map(({ label, text, href, icon }) => {
    const Tag = href ? 'a' : 'div';
    return <Tag class="contact-row" href={href || undefined}>
      <span class="contact-row__hex"><img src={`/assets/${icon}`} width="32" height="32" loading="lazy" alt="" aria-hidden="true" /></span>
      <span><span class="contact-row__label">{label}</span><span>{text}</span></span>
    </Tag>;
  })}
</address>
<style>
  .contact-details { display: grid; gap: 20px; font-style: normal; }
  .contact-row { display: flex; align-items: center; gap: 20px; width: fit-content; max-width: 100%; font-size: .9rem; overflow-wrap: anywhere; }
  a.contact-row:hover { text-decoration: underline; text-underline-offset: 4px; }
  .contact-row__label { display: block; color: var(--color-muted); font-size: .65rem; letter-spacing: .07em; text-transform: uppercase; }
  .contact-row__hex { position: relative; flex: 0 0 56px; display: grid; place-items: center; width: 56px; height: 50px; background: var(--color-primary); clip-path: var(--hexagon); }
  .contact-row__hex::before { content: ''; position: absolute; inset: 2px; background: var(--color-white); clip-path: inherit; }
  .contact-row__hex img { position: relative; width: 29px; height: 29px; object-fit: contain; }
</style>
