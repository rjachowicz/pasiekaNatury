---
import AssetImage from './AssetImage.astro';
interface Props { title: string; description: string; icon: string; index?: number; }
const { title, description, icon, index } = Astro.props;
---
<article class="feature-tile" data-reveal>
  <div class="feature-tile__top">
    <AssetImage src={`/assets/${icon}`} loading="lazy" alt="" aria-hidden="true" />
    {index !== undefined && <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
<style>
  .feature-tile { min-width: 0; padding: 28px; border: 1px solid var(--color-border); background: var(--color-white); transition: border-color var(--transition); }
  .feature-tile:hover { border-color: #c2ac70; }
  .feature-tile__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .feature-tile__top img { width: 32px; height: 32px; object-fit: contain; }
  .feature-tile__top span { font-size: .6875rem; color: var(--color-muted); }
  h3 { font-size: 1.9rem; }
  p { margin-top: 12px; max-width: 44ch; color: var(--color-muted); font-size: .8125rem; }
  @media (max-width: 899px) {
    .feature-tile { display: grid; grid-template-columns: 36px minmax(0, 1fr); column-gap: 20px; padding: 24px; }
    .feature-tile__top { grid-row: span 2; margin: 0; align-items: start; }
    .feature-tile__top span { display: none; }
    p { margin-top: 8px; }
  }
</style>
