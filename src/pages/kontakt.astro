---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactDetails from '../components/ContactDetails.astro';
import CallToAction from '../components/CallToAction.astro';
import { contact } from '../data/site';
---
<BaseLayout title="Kontakt — Pasieka 100% Natury" description="Skontaktuj się z Pasieką 100% Natury. Zapytaj o miody, dostępne gramatury i możliwość odbioru. Chętnie odpowiemy na Twoje pytania.">
  <PageHero eyebrow="Kontakt" title="Zapraszamy do kontaktu">
    <p>Porozmawiajmy o miodzie i pszczołach. Chętnie odpowiemy na pytania i pomożemy wybrać smak dla Ciebie.</p>
  </PageHero>
  <section class="section contact-page">
    <div class="container split-content">
      <div>
        <SectionHeading eyebrow="Bądźmy w kontakcie" title="Napisz lub zadzwoń" />
        <div class="prose"><p>Chcesz poznać dostępne miody, zapytać o gramatury lub ustalić odbiór? Skontaktuj się z nami. Przed wizytą w pasiece umów dogodny termin.</p></div>
        <img class="contact-page__bee" src="/assets/bee-flight.png" width="2048" height="682" loading="lazy" alt="" aria-hidden="true" />
      </div>
      <ContactDetails />
    </div>
    <img class="contact-page__flowers" src="/assets/flowers.png" width="208" height="623" loading="lazy" alt="" aria-hidden="true" />
  </section>
  <section class="section soft-section">
    <div class="container">
      <div class="map-heading">
        <SectionHeading eyebrow="Odwiedź nas" title="Jak do nas trafić" />
        <p class="prose">Przed przyjazdem zadzwoń, aby ustalić termin i szczegóły dojazdu.</p>
      </div>
      <div class="map-placeholder" role="region" aria-label="Miejsce na mapę dojazdu — mapa nie jest jeszcze dostępna">
        <img src="/assets/icon-location.png" width="512" height="512" loading="lazy" alt="" aria-hidden="true" />
        <p class="map-placeholder__address">{contact.address}</p>
        <p>Mapa dojazdu pojawi się tutaj.</p>
        <a href={contact.phoneHref}>Zadzwoń i zapytaj o dojazd <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <CallToAction title="Dobry miód zaczyna się od rozmowy" href="/produkty" label="Poznaj nasze miody">
    <p>Nie wiesz, który smak wybrać? Poznaj nasze miody — a o szczegóły zapytaj nas telefonicznie lub mailowo.</p>
  </CallToAction>
</BaseLayout>
<style>
  .contact-page { position: relative; isolation: isolate; overflow: hidden; }
  .contact-page__bee { width: 220px; margin-top: 32px; }
  .contact-page__flowers { position: absolute; z-index: -1; right: -20px; bottom: 0; width: 150px; opacity: .2; }
  .map-heading { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 40px; }
  .map-heading > p { max-width: 38ch; font-size: .9rem; }
  .map-placeholder { min-height: 360px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 24px; border: 1px solid var(--color-border); background: var(--color-background); text-align: center; }
  .map-placeholder img { width: 48px; height: 48px; margin-bottom: 20px; }
  .map-placeholder__address { font-family: var(--font-serif); font-size: 2rem; }
  .map-placeholder > p + p { margin-top: 8px; color: var(--color-muted); font-size: .85rem; }
  .map-placeholder a { margin-top: 24px; padding: 8px 0; border-bottom: 2px solid var(--color-primary); font-size: .8rem; font-weight: 600; }
  @media (max-width: 767px) { .map-heading { flex-direction: column; align-items: flex-start; gap: 24px; } }
</style>
