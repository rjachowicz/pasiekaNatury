---
import AssetImage from '../components/AssetImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactDetails from '../components/ContactDetails.astro';
import CallToAction from '../components/CallToAction.astro';
import Button from '../components/Button.astro';
import { contact } from '../data/site';
---
<BaseLayout title="Kontakt — Pasieka 100% Natury" description="Skontaktuj się z Pasieką 100% Natury. Zapytaj o miody, dostępne gramatury i możliwość odbioru. Chętnie odpowiemy na Twoje pytania.">
  <PageHero eyebrow="Kontakt" title="Zapraszamy do kontaktu">
    <p>Porozmawiajmy o miodzie i pszczołach. Chętnie odpowiemy na pytania i pomożemy wybrać smak dla Ciebie.</p>
  </PageHero>
  <section class="section contact-page">
    <div class="container split-content">
      <div>
        <SectionHeading eyebrow="Bądźmy w kontakcie" title="Napisz lub zadzwoń" />
        <div class="prose"><p>Chcesz poznać dostępne miody, zapytać o gramatury lub ustalić odbiór? Skontaktuj się z nami. Przed wizytą w pasiece umów dogodny termin.</p></div>
        <AssetImage class="contact-page__bee" src="/assets/bee-flight.png" widths={[160, 320]} sizes="160px" loading="lazy" alt="" aria-hidden="true" />
      </div>
      <ContactDetails />
    </div>
  </section>
  <section class="section soft-section">
    <div class="container">
      <div class="directions">
        <div>
          <SectionHeading eyebrow="Odwiedź nas" title="Dojazd do pasieki" />
          <p class="prose">Przed przyjazdem zadzwoń, aby ustalić termin i szczegóły dojazdu. Chętnie pomożemy zaplanować wizytę.</p>
        </div>
        <div class="directions__details">
          <div class="directions__address">
            <AssetImage src="/assets/icon-location.png" loading="lazy" alt="" aria-hidden="true" />
            <div><span class="eyebrow">Pasieka 100% Natury</span><p>{contact.address}</p></div>
          </div>
          {contact.directionsUrl ? <Button href={contact.directionsUrl}>Wyznacz trasę</Button> : <Button href={contact.phoneHref}>Zapytaj o dojazd</Button>}
        </div>
      </div>
    </div>
  </section>
  <CallToAction title="Dobry miód zaczyna się od rozmowy" href="/produkty" label="Poznaj nasze miody">
    <p>Nie wiesz, który smak wybrać? Poznaj nasze miody — a o szczegóły zapytaj nas telefonicznie lub mailowo.</p>
  </CallToAction>
</BaseLayout>
<style>
  .contact-page__bee { width: 160px; margin-top: var(--space-4); opacity: .65; }
  .directions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: var(--space-grid); }
  .directions .prose { margin-top: var(--space-3); max-width: 46ch; }
  .directions__details { padding-left: var(--space-grid); border-left: 1px solid var(--color-border); }
  .directions__address { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  .directions__address img { flex-shrink: 0; width: 32px; height: 32px; }
  .directions__address .eyebrow { font-size: .625rem; }
  .directions__address p { margin-top: 4px; font: 600 1.9rem/1.2 var(--font-serif); overflow-wrap: anywhere; }
  @media (max-width: 899px) {
    .directions { grid-template-columns: 1fr; }
    .directions__details { padding: var(--space-4) 0 0; border-left: 0; border-top: 1px solid var(--color-border); }
  }
</style>
