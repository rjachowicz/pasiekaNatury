---
import ProductDetailPage from "../../components/products/ProductDetailPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };
---

<BaseLayout
  title={`${product.name} | Pasieka w Jasiennej`}
  description={`${product.shortDescription} Katalog Pasieki 100% Natury w Jasiennej.`}
  image={product.image}
  imageAlt={`Produkt: ${product.name.toLocaleLowerCase("pl")}`}
  breadcrumbs={[
    { name: "Strona główna", path: "/" },
    { name: "Produkty", path: "/produkty" },
    { name: product.name, path: `/produkty/${product.id}` },
  ]}
>
  <ProductDetailPage product={product} />
</BaseLayout>
