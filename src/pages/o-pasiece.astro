---
import AssetImage from '../components/AssetImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ValuesSection from '../components/home/ValuesSection.astro';
import ApiarySection from '../components/home/ApiarySection.astro';
import CallToAction from '../components/CallToAction.astro';
---
<BaseLayout title="O pasiece — Pasieka 100% Natury" description="Poznaj pasję, wartości i codzienność Pasieki 100% Natury. Pszczoły, pszczelarskie rzemiosło i wędrówki w rytmie natury.">
  <PageHero eyebrow="O pasiece" title="Pasja, natura i tradycja">
    <p>Blisko pszczół, w rytmie pór roku. Poznaj to, co jest dla nas ważne w codziennej pracy przy pasiece.</p>
  </PageHero>
  <section class="section">
    <div class="container split-content">
      <div>
        <SectionHeading eyebrow="Historia pasieki" title="Wszystko zaczyna się od ciekawości natury" />
        <div class="prose">
          <!-- Tekst roboczy. Uzupełnij prawdziwą historię, daty i osoby przed publikacją. -->
          <p>Pasieka to dla nas spotkanie z naturą. Obserwowanie pszczół pozwala dostrzec, jak wiele zależy od małych, codziennych działań — i jak ważne jest otoczenie, w którym żyjemy.</p>
          <p>Chcemy dzielić się nie tylko miodem, ale też zainteresowaniem światem pszczół. To właśnie tej idei poświęcamy naszą pasiekę: uważności, prostocie i szacunkowi do naturalnego rytmu.</p>
        </div>
      </div>
      <AssetImage class="split-content__image" sizes="(max-width: 899px) 92vw, 46vw" src="/assets/beekeeper.jpg" loading="lazy" alt="Pszczelarz przy ulach, z ramką pszczelą w dłoniach" />
    </div>
  </section>
  <section class="section soft-section beekeeper-story">
    <div class="container beekeeper-story__inner">
      <div class="beekeeper-story__heading">
        <SectionHeading eyebrow="O pszczelarzu" title="Cierpliwość jest częścią tego rzemiosła" />
        <p class="beekeeper-story__motto">Pszczoły uczą<br /><em>pokory do natury.</em></p>
      </div>
      <div>
        <div class="prose">
          <!-- Miejsce na osobistą historię i przedstawienie właściciela pasieki. -->
          <p>Praca z pszczołami wymaga spokoju, obserwacji i gotowości do ciągłego uczenia się. Każdy przegląd ula to okazja, by lepiej poznać potrzeby pszczelej rodziny.</p>
          <p>Najbliższe są nam proste zasady: troska o pszczoły, uważny wybór miejsc i rzetelność w pracy. O pasiece i jej codzienności najchętniej opowiadamy w rozmowie.</p>
        </div>
      </div>
    </div>
  </section>
  <ValuesSection />
  <ApiarySection />
  <CallToAction title="Poznaj nasze miody" href="/produkty" label="Zobacz nasze miody">
    <p>Od delikatnych kwiatowych nut po głębokie leśne aromaty. Znajdź swój ulubiony smak.</p>
  </CallToAction>
</BaseLayout>
<style>
  .beekeeper-story { position: relative; isolation: isolate; }
  .beekeeper-story::before { content: ''; position: absolute; z-index: -1; inset: 0; background: url('/assets/honeycomb.png') left center / 600px auto no-repeat; opacity: .045; pointer-events: none; }
  .beekeeper-story__inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-grid); align-items: center; }
  .beekeeper-story__motto { margin-top: var(--space-4); padding-left: var(--space-3); border-left: 2px solid var(--color-primary); font: 500 clamp(1.8rem, 2.5vw, 2.4rem)/1.2 var(--font-serif); }
  .beekeeper-story .prose { max-width: 49ch; }
  @media (max-width: 899px) { .beekeeper-story__inner { grid-template-columns: 1fr; } }
</style>
